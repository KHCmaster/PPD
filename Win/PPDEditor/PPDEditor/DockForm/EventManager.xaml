<forms:DockView x:Class="PPDEditor.EventManager"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:forms="clr-namespace:PPDEditor.Forms"
                xmlns:controls="clr-namespace:PPDEditor.Controls">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="282" HorizontalAlignment="Left">
            <DataGrid x:Name="dataGridView1" Height="132" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      SelectionUnit="FullRow" HeadersVisibility="Column" CanUserSortColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="Column1" Header="時間" Binding="{Binding Key}" Width="Auto" />
                    <DataGridTextColumn x:Name="Column2" Header="イベント" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Margin="12,6,12,12">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="button1" Content="イベント追加" MinWidth="91" Height="23" Padding="6,0" Click="Button1_Click" />
                    <Button x:Name="button3" Content="選択した行のイベント編集" MinWidth="120" Height="23" Margin="6,0,0,0" Padding="6,0" Click="Button3_Click" />
                </StackPanel>
                <Button x:Name="button2" Content="選択した行のイベント削除" HorizontalAlignment="Left" MinWidth="182" Height="23" Margin="0,6,0,0" Padding="6,0" Click="Button2_Click" />
                <DockPanel Width="208" HorizontalAlignment="Left" Margin="0,8,0,0">
                    <controls:NumericUpDown x:Name="numericUpDown1" DockPanel.Dock="Right" Width="100" DecimalPlaces="2" Increment="0.01" Minimum="-100" Maximum="100" />
                    <TextBlock x:Name="label1" Text="ずらす時間" VerticalAlignment="Center" />
                </DockPanel>
                <Button x:Name="button4" Content="選択した行の時間をずらす" HorizontalAlignment="Left" Width="208" Height="23" Margin="0,6,0,0" Click="Button4_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</forms:DockView>
