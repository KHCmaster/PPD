<forms:DockView x:Class="PPDEditor.ScriptManager"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ad="https://github.com/Dirkster99/AvalonDock"
                xmlns:forms="clr-namespace:PPDEditor.Forms"
                xmlns:controls="clr-namespace:PPDEditor.Controls"
                xmlns:script="clr-namespace:PPDEditor.DockForm.Script"
                xmlns:flow="clr-namespace:FlowScriptControl.Controls;assembly=FlowScriptControl"
                KeyDown="ScriptManager_KeyDown">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem x:Name="編集MenuItem" Header="編集">
                <MenuItem x:Name="元に戻すMenuItem" Header="元に戻す" InputGestureText="Ctrl+Z" Click="元に戻すMenuItem_Click" />
                <MenuItem x:Name="やり直すMenuItem" Header="やり直す" InputGestureText="Ctrl+Y" Click="やり直すMenuItem_Click" />
                <Separator />
                <MenuItem x:Name="切り取りMenuItem" Header="切り取り" InputGestureText="Ctrl+X" Click="切り取りMenuItem_Click" />
                <MenuItem x:Name="コピーMenuItem" Header="コピー" InputGestureText="Ctrl+C" Click="コピーMenuItem_Click" />
                <MenuItem x:Name="貼り付けMenuItem" Header="貼り付け" InputGestureText="Ctrl+V" Click="貼り付けMenuItem_Click" />
                <MenuItem x:Name="リンクも貼り付けMenuItem" Header="リンクも貼り付け" InputGestureText="Ctrl+Shift+V" Click="リンクも貼り付けMenuItem_Click" />
                <MenuItem x:Name="削除MenuItem" Header="削除" InputGestureText="Del" Click="削除MenuItem_Click" />
                <Separator />
                <MenuItem x:Name="表示領域を合わせるMenuItem" Header="表示領域を合わせる" Click="表示領域を合わせるMenuItem_Click" />
                <MenuItem x:Name="全て展開MenuItem" Header="全て展開" Click="全て展開MenuItem_Click" />
                <MenuItem x:Name="全て縮小MenuItem" Header="全て縮小" Click="全て縮小MenuItem_Click" />
            </MenuItem>
            <MenuItem x:Name="表示MenuItem" Header="表示" SubmenuOpened="表示MenuItem_SubmenuOpened">
                <MenuItem x:Name="プロパティMenuItem" Header="プロパティ" Click="プロパティMenuItem_Click" />
                <MenuItem x:Name="スクリプトリストMenuItem" Header="スクリプトリスト" Click="スクリプトリストMenuItem_Click" />
                <MenuItem x:Name="ソースリストMenuItem" Header="ソースリスト" Click="ソースリストMenuItem_Click" />
                <MenuItem x:Name="検索MenuItem" Header="検索" Click="検索MenuItem_Click" />
                <MenuItem x:Name="デバッグMenuItem" Header="デバッグ" Click="デバッグMenuItem_Click" />
                <MenuItem x:Name="ログMenuItem" Header="ログ" Click="ログMenuItem_Click" />
            </MenuItem>
        </Menu>
        <!-- デバッグ中だけ出す -->
        <ToolBar x:Name="toolStrip1" DockPanel.Dock="Top" ToolBarTray.IsLocked="True" Visibility="Collapsed">
            <Button x:Name="toolStripButton1" ToolTip="続行" Click="ToolStripButton1_Click">
                <Image Source="/img/playonce.png" Stretch="None" />
            </Button>
            <Button x:Name="toolStripButton2" ToolTip="ステップイン" Click="ToolStripButton2_Click">
                <Image Source="/img/stepin.png" Stretch="None" />
            </Button>
        </ToolBar>
        <ad:DockingManager x:Name="dockingManager">
            <ad:DockingManager.DocumentContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="保存MenuItem" Header="保存" Click="保存MenuItem_Click" />
                    <MenuItem x:Name="閉じるMenuItem" Header="閉じる" Click="閉じるMenuItem_Click" />
                </ContextMenu>
            </ad:DockingManager.DocumentContextMenu>
            <ad:LayoutRoot>
                <ad:LayoutPanel Orientation="Horizontal">
                    <ad:LayoutAnchorablePaneGroup Orientation="Vertical" DockWidth="200">
                        <ad:LayoutAnchorablePane>
                            <ad:LayoutAnchorable x:Name="scriptListAnchorable" ContentId="PPDEditor.DockForm.Script.ScriptListDockForm" Title="スクリプトリスト" CanClose="False">
                                <script:ScriptListPanel x:Name="scriptListForm" />
                            </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>
                        <ad:LayoutAnchorablePane>
                            <ad:LayoutAnchorable x:Name="logAnchorable" ContentId="PPDEditor.DockForm.Script.FlowLogDockForm" Title="ログ" CanClose="False">
                                <script:FlowLogPanel x:Name="logForm" />
                            </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>
                    </ad:LayoutAnchorablePaneGroup>
                    <ad:LayoutDocumentPaneGroup>
                        <ad:LayoutDocumentPane />
                    </ad:LayoutDocumentPaneGroup>
                    <ad:LayoutAnchorablePaneGroup Orientation="Vertical" DockWidth="250">
                        <ad:LayoutAnchorablePane>
                            <ad:LayoutAnchorable x:Name="searchAnchorable" ContentId="PPDEditor.DockForm.Script.FlowSearchDockForm" Title="検索" CanClose="False">
                                <flow:FlowSearchPanel x:Name="searchPanel" />
                            </ad:LayoutAnchorable>
                            <ad:LayoutAnchorable x:Name="treeViewAnchorable" ContentId="PPDEditor.DockForm.Script.FlowTreeViewDockForm" Title="ソースリスト" CanClose="False">
                                <flow:FlowTreeView x:Name="treeView" />
                            </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>
                        <ad:LayoutAnchorablePane>
                            <ad:LayoutAnchorable x:Name="propertyAnchorable" ContentId="PPDEditor.DockForm.Script.FlowPropertyDockForm" Title="プロパティ" CanClose="False">
                                <controls:CustomFlowPropertyPanel x:Name="propertyPanel" />
                            </ad:LayoutAnchorable>
                            <ad:LayoutAnchorable x:Name="executingPropertyAnchorable" ContentId="PPDEditor.DockForm.Script.FlowExecutingPropertyDockForm" Title="デバッグ" CanClose="False">
                                <flow:FlowExecutingPropertyPanel x:Name="executingPropertyPanel" />
                            </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>
                    </ad:LayoutAnchorablePaneGroup>
                </ad:LayoutPanel>
            </ad:LayoutRoot>
        </ad:DockingManager>
    </DockPanel>
</forms:DockView>
