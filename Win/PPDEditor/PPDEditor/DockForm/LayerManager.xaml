<forms:DockView x:Class="PPDEditor.LayerManager"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:forms="clr-namespace:PPDEditor.Forms">
    <ScrollViewer x:Name="scrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="Transparent">
        <ScrollViewer.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="新規レイヤーMenuItem" Header="新規レイヤー" Click="新規レイヤーMenuItem_Click" />
            </ContextMenu>
        </ScrollViewer.ContextMenu>
        <Grid VerticalAlignment="Top">
            <StackPanel x:Name="layersPanel" />
            <!-- ドラッグで並べ替えるときに、つかんでいるレイヤーの絵と入る場所の線を書く -->
            <Canvas x:Name="dragCanvas" IsHitTestVisible="False" ClipToBounds="False">
                <Rectangle x:Name="dragImage" Opacity="0.6" Visibility="Collapsed" />
                <Rectangle x:Name="dropBar" Height="3" Fill="Black" Visibility="Collapsed" />
            </Canvas>
        </Grid>
    </ScrollViewer>
</forms:DockView>
