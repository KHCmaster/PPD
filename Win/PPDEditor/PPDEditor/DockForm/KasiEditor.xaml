<forms:DockView x:Class="PPDEditor.KasiEditor"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:forms="clr-namespace:PPDEditor.Forms"
                xmlns:controls="clr-namespace:PPDEditor.Controls">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="232" HorizontalAlignment="Left">
            <DataGrid x:Name="dataGridView1" Height="196" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      SelectionUnit="FullRow" HeadersVisibility="Column" CanUserSortColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="Column1" Header="時間(秒)" Binding="{Binding Key}" Width="Auto" />
                    <DataGridTextColumn x:Name="Column2" Header="テキスト" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Margin="12,6,12,0">
                <DockPanel>
                    <Button x:Name="button6" DockPanel.Dock="Right" Content="X" Width="23" Height="21" Click="Button6_Click" />
                    <TextBlock x:Name="label1" Text="ここに歌詞を入力" VerticalAlignment="Bottom" />
                </DockPanel>
                <TextBox x:Name="textBox1" Height="98" Margin="0,2,0,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                <Button x:Name="button1" Content="現在の時間に追加する" Height="24" Margin="0,4,0,0" Click="Button1_Click" />
                <Button x:Name="button2" Content="選択した行を削除" Height="24" Margin="0,6,0,0" Click="Button2_Click" />
                <DockPanel Margin="0,8,0,0">
                    <controls:NumericUpDown x:Name="numericUpDown1" DockPanel.Dock="Right" Width="100" DecimalPlaces="2" Increment="0.01" Minimum="-100" Maximum="100" />
                    <TextBlock x:Name="label2" Text="ずらす時間" VerticalAlignment="Center" />
                </DockPanel>
                <Button x:Name="button3" Content="選択した行の時間をずらす" Height="24" Margin="0,6,0,0" Click="Button3_Click" />
                <Button x:Name="button4" Content="選択した行のテキストを変更する" Height="24" Margin="0,6,0,0" Click="Button4_Click" />
                <Button x:Name="button5" Content="選択行をコピーして現在の時間に追加" Height="24" Margin="0,6,0,12" Click="Button5_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</forms:DockView>
