<forms:DockView x:Class="PPDEditor.MemoWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:forms="clr-namespace:PPDEditor.Forms">
    <TextBox x:Name="textBox1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
             HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible"
             TextChanged="TextBox1_TextChanged" PreviewKeyDown="TextBox1_KeyDown" PreviewMouseWheel="TextBox1_MouseWheel" />
</forms:DockView>
