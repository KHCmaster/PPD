<forms:DockView x:Class="PPDEditor.MemoWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:forms="clr-namespace:PPDEditor.Forms"
                xmlns:vm="clr-namespace:PPDEditor.ViewModels.Docks"
                mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:MemoViewModel}">
    <!-- Ctrl+「+」「-」とホイールで文字の大きさを変える（以前と同じ） -->
    <TextBox Text="{Binding MemoText, UpdateSourceTrigger=PropertyChanged}" FontSize="{Binding FontSizePixels}"
             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
             HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" PreviewMouseWheel="TextBox_MouseWheel">
        <TextBox.InputBindings>
            <KeyBinding Modifiers="Ctrl" Key="OemPlus" Command="{Binding IncreaseFontSizeCommand}" />
            <KeyBinding Modifiers="Ctrl" Key="OemMinus" Command="{Binding DecreaseFontSizeCommand}" />
        </TextBox.InputBindings>
    </TextBox>
</forms:DockView>
