<forms:DockView x:Class="PPDEditor.GeometryCreator"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:forms="clr-namespace:PPDEditor.Forms"
                xmlns:controls="clr-namespace:PPDEditor.Controls"
                xmlns:bezier="clr-namespace:BezierDrawControl;assembly=BezierDrawControl"
                xmlns:vm="clr-namespace:PPDEditor.ViewModels.Docks"
                xmlns:conv="clr-namespace:PPDEditor.Converters"
                mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:GeometryCreatorViewModel}"
                PreviewKeyDown="GeometryCreator_PreviewKeyDown">
    <forms:DockView.Resources>
        <conv:EnumToBooleanConverter x:Key="EnumToBoolean" />
        <conv:InverseBooleanConverter x:Key="Inverse" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="23" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style x:Key="TransformBox" TargetType="TextBox">
            <Setter Property="Width" Value="80" />
            <Setter Property="Margin" Value="2,0,6,0" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </forms:DockView.Resources>
    <DockPanel>
        <!-- 変形モードのときだけ出す -->
        <Border DockPanel.Dock="Top" Visibility="{Binding IsTransforming, Converter={StaticResource BoolToVisibility}}"
                Background="{x:Static SystemColors.ControlBrush}" Padding="4,2">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="W:" VerticalAlignment="Center" />
                <TextBox Text="{Binding TransformWidth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TransformBox}" />
                <TextBlock Text="H:" VerticalAlignment="Center" />
                <TextBox Text="{Binding TransformHeight, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TransformBox}" />
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                <Image Source="/img/angle.png" Stretch="None" VerticalAlignment="Center" Margin="4,0,0,0" />
                <TextBox Text="{Binding TransformRotation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TransformBox}" />
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                <TextBlock Text="X:" VerticalAlignment="Center" />
                <TextBox Text="{Binding TransformX, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TransformBox}" />
                <TextBlock Text="Y:" VerticalAlignment="Center" />
                <TextBox Text="{Binding TransformY, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TransformBox}" />
                <Button Content="{Binding Texts[GCSetDefault]}" ToolTip="{Binding Texts[GCSetDefault]}" Command="{Binding ResetTransformCommand}" />
            </StackPanel>
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid Margin="12,5,12,12" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="600" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="325" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- マウスを止めてしばらくすると、今のモードの操作方法を出す -->
                <bezier:WpfBezierControl x:Name="bezierControl1" ToolTipService.InitialShowDelay="2000" ToolTipService.ShowDuration="60000"
                                         ToolTipOpening="BezierControl1_ToolTipOpening">
                    <bezier:WpfBezierControl.ToolTip>
                        <ToolTip x:Name="hintToolTip" />
                    </bezier:WpfBezierControl.ToolTip>
                </bezier:WpfBezierControl>

                <!-- 文字の色はスキンに合わせる（SetSkin で変える） -->
                <StackPanel x:Name="optionPanel" Grid.Column="1" Grid.RowSpan="2" Width="174" Margin="6,0,0,0">
                    <CheckBox Content="{Binding Texts[GCCheckBox1]}" IsChecked="{Binding Antialias}" />
                    <CheckBox Content="{Binding Texts[GCCheckBox2]}" IsChecked="{Binding DrawPos}" />
                    <CheckBox Content="{Binding Texts[GCCheckBox3]}" IsChecked="{Binding DrawAngle}" />
                    <CheckBox Content="グリッドを表示" IsChecked="{Binding SquareGridEnabled}" />
                    <Button Content="グリッドの設定" HorizontalAlignment="Right" MinWidth="110" Command="{Binding EditGridCommand}" />
                    <CheckBox Content="{Binding Texts[GCCheckBox4]}" IsChecked="{Binding ApplyMoved}" Margin="0,8,0,6" />
                    <Button AutomationProperties.AutomationId="GeometryApplyButton" Content="{Binding Texts[GCButton1]}" Command="{Binding ApplyCommand}" />
                    <GroupBox Header="{Binding Texts[GCGroup1]}">
                        <StackPanel>
                            <DockPanel>
                                <RadioButton DockPanel.Dock="Right" AutomationProperties.AutomationId="GeometryPolygonRadio" GroupName="Shape" Content="{Binding Texts[GCRadioButton2]}" IsChecked="{Binding CreatePolygon}" />
                                <RadioButton GroupName="Shape" Content="{Binding Texts[GCRadioButton1]}" IsChecked="{Binding CreatePolygon, Converter={StaticResource Inverse}}" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <controls:DragValueLabel Text="{Binding Texts[GCLabel1]}" VerticalAlignment="Center" Margin="0,0,6,0" ValueChange="PolygonCountLabel_ValueChange" />
                                <TextBox Text="{Binding PolygonCount, UpdateSourceTrigger=PropertyChanged}" Width="47" />
                            </StackPanel>
                            <Button AutomationProperties.AutomationId="GeometryGenerateButton" Content="{Binding Texts[GCButton2]}" HorizontalAlignment="Left" MinWidth="110" Margin="0,4,0,0" Command="{Binding GenerateCommand}" />
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="{Binding Texts[GCGroup3]}">
                        <StackPanel>
                            <RadioButton GroupName="Interval" Content="{Binding Texts[GCRadioButton8]}" Margin="0,0,0,4"
                                         IsChecked="{Binding IntervalMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Time}" />
                            <RadioButton GroupName="Interval" Content="{Binding Texts[GCRadioButton9]}" Margin="0,0,0,4"
                                         IsChecked="{Binding IntervalMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Even1}" />
                            <RadioButton GroupName="Interval" Content="{Binding Texts[GCRadioButton10]}" Margin="0,0,0,4"
                                         IsChecked="{Binding IntervalMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Even2}" />
                            <DockPanel>
                                <TextBox DockPanel.Dock="Right" Text="{Binding FixedDistanceText, UpdateSourceTrigger=PropertyChanged}" Width="40" IsEnabled="{Binding IsFixedDistanceEnabled}" />
                                <RadioButton GroupName="Interval" Content="{Binding Texts[GCRadioButton11]}" VerticalAlignment="Center"
                                             IsChecked="{Binding IntervalMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=FixedDistance}" />
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Top">
                    <GroupBox x:Name="angleGroup" Header="{Binding Texts[GCGroup2]}" Width="322" Margin="0">
                        <StackPanel>
                            <UniformGrid Columns="4">
                                <RadioButton GroupName="Angle" Content="{Binding Texts[GCRadioButton3]}"
                                             IsChecked="{Binding AngleMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Tangent1}" />
                                <RadioButton GroupName="Angle" Content="{Binding Texts[GCRadioButton5]}"
                                             IsChecked="{Binding AngleMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Tangent2}" />
                                <RadioButton GroupName="Angle" Content="{Binding Texts[GCRadioButton4]}"
                                             IsChecked="{Binding AngleMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Normal1}" />
                                <RadioButton GroupName="Angle" Content="{Binding Texts[GCRadioButton6]}"
                                             IsChecked="{Binding AngleMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Normal2}" />
                            </UniformGrid>
                            <RadioButton GroupName="Angle" Content="{Binding Texts[GCRadioButton7]}" Margin="0,6,0,0"
                                         IsChecked="{Binding AngleMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=None}" />
                        </StackPanel>
                    </GroupBox>
                    <StackPanel Margin="8,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Texts[GCLabel2]}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <controls:NumericUpDown Width="50" Minimum="0" Maximum="90" Value="{Binding AngleRestriction}" />
                        </StackPanel>
                        <Button AutomationProperties.AutomationId="GeometryClearButton" Content="{Binding Texts[GCButton3]}" HorizontalAlignment="Left" MinWidth="110" Margin="0,8,0,0" Command="{Binding ClearCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</forms:DockView>
