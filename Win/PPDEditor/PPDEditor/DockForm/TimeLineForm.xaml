<forms:DockView x:Class="PPDEditor.TimeLineForm"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:forms="clr-namespace:PPDEditor.Forms"
                xmlns:controls="clr-namespace:PPDEditor.Controls"
                xmlns:vm="clr-namespace:PPDEditor.ViewModels.Docks"
                mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:TimeLineViewModel}"
                KeyDown="TimeLineForm_KeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="95" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <controls:Seekex x:Name="seekex1" />
        <controls:Seekmain x:Name="seekmain1" AutomationProperties.AutomationId="Seekmain" Grid.Column="2">
            <controls:Seekmain.ContextMenu>
                <!-- DataContext はタイムラインの ViewModel（ContextMenu は置いた場所の DataContext を受け継ぐ） -->
                <ContextMenu Opened="ContextMenu_Opened">
                    <MenuItem Header="{Binding Texts[AssignID]}" Command="{Binding AssignIDCommand}" />
                    <MenuItem Header="{Binding Texts[DeassignID]}" Command="{Binding UnassignIDCommand}" />
                    <MenuItem Header="{Binding Texts[InterpolatePosition]}" Command="{Binding InterpolatePositionCommand}" />
                    <MenuItem Header="{Binding Texts[InterpolateAngle]}">
                        <MenuItem Header="{Binding Texts[Clockwise]}" Command="{Binding InterpolateAngleClockwiseCommand}" />
                        <MenuItem Header="{Binding Texts[Unclockwise]}" Command="{Binding InterpolateAngleCounterclockwiseCommand}" />
                    </MenuItem>
                    <MenuItem Header="{Binding Texts[Parameter]}" ItemsSource="{Binding Presets}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="ItemsSource" Value="{Binding Children}" />
                                <Setter Property="ToolTip" Value="{Binding Name}" />
                                <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
                                <Setter Property="Command" Value="{Binding DataContext.TogglePresetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Setter Property="CommandParameter" Value="{Binding}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Style.Triggers>
                                    <!-- 一部のマークにだけ当てはまるプリセットに印を付ける -->
                                    <DataTrigger Binding="{Binding IsPartial}" Value="True">
                                        <Setter Property="Icon" Value="－" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.ItemContainerStyle>
                        <MenuItem.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <!-- 名前の「_」がアクセスキーとして扱われないように、TextBlock で表示する -->
                                <TextBlock Text="{Binding Name}" />
                            </HierarchicalDataTemplate>
                        </MenuItem.ItemTemplate>
                    </MenuItem>
                </ContextMenu>
            </controls:Seekmain.ContextMenu>
        </controls:Seekmain>
    </Grid>
</forms:DockView>
