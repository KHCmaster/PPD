<forms:DockView x:Class="PPDEditor.TimeLineForm"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:forms="clr-namespace:PPDEditor.Forms"
                xmlns:controls="clr-namespace:PPDEditor.Controls"
                KeyDown="TimeLineForm_KeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="95" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <controls:Seekex x:Name="seekex1" />
        <controls:Seekmain x:Name="seekmain1" Grid.Column="2">
            <controls:Seekmain.ContextMenu>
                <ContextMenu Opened="ContextMenuStrip1_Opened">
                    <MenuItem x:Name="選択中のマークにIDを割り当てMenuItem" Header="選択中のマークにIDを割り当て" Click="選択中のマークにIDを割り当てMenuItem_Click" />
                    <MenuItem x:Name="選択中のマークのID割り当てを解除MenuItem" Header="選択中のマークのID割り当てを解除" Click="選択中のマークのID割り当てを解除MenuItem_Click" />
                    <MenuItem x:Name="位置を線形補完MenuItem" Header="位置を線形補完" Click="位置を線形補完MenuItem_Click" />
                    <MenuItem x:Name="角度を線形補完MenuItem" Header="角度を線形補完">
                        <MenuItem x:Name="時計回りMenuItem" Header="時計回り" Click="時計回りMenuItem_Click" />
                        <MenuItem x:Name="反時計回りMenuItem" Header="反時計回り" Click="反時計回りMenuItem_Click" />
                    </MenuItem>
                    <MenuItem x:Name="パラメーターMenuItem" Header="パラメーター" />
                </ContextMenu>
            </controls:Seekmain.ContextMenu>
        </controls:Seekmain>
    </Grid>
</forms:DockView>
