<forms:DockView x:Class="PPDEditor.StatsManager"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:forms="clr-namespace:PPDEditor.Forms"
                xmlns:controls="clr-namespace:PPDEditor.Controls"
                xmlns:vm="clr-namespace:PPDEditor.ViewModels.Docks"
                mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:StatsManagerViewModel}">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{Binding Texts[UpdateData]}" Command="{Binding UpdateCommand}" />
        </Menu>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="128" MinWidth="40" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}" DisplayMemberPath="Name" />
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />
            <TabControl Grid.Column="2">
                <TabItem Header="{Binding Texts[Data]}">
                    <DataGrid ItemsSource="{Binding DataRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="None"
                              CanUserSortColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Key}" Width="*" />
                            <DataGridTextColumn Binding="{Binding Value}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="{Binding Texts[Visualization]}">
                    <Grid>
                        <controls:PieChart Items="{Binding PieItems}" Margin="0,32,0,0" />
                        <ComboBox ItemsSource="{Binding ChartModeNames}" SelectedIndex="{Binding ChartModeIndex}" Width="121" Margin="6"
                                  HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </Grid>
                </TabItem>
                <TabItem Header="{Binding Texts[Difficulty]}">
                    <controls:TimeColumnChart Points="{Binding DifficultyPoints}" HighlightTime="{Binding HighlightTime}" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</forms:DockView>
