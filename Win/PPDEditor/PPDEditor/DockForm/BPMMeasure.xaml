<forms:DockView x:Class="PPDEditor.BPMMeasure"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:forms="clr-namespace:PPDEditor.Forms"
                PreviewKeyDown="BPMMeasure_KeyDown" PreviewKeyUp="BPMMeasure_KeyUp">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid Margin="14,14,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="130" />
                <ColumnDefinition Width="Auto" MinWidth="60" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="22" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="label1" Text="時間差" VerticalAlignment="Center" />
            <TextBlock x:Name="label3" Grid.Column="1" Text="0" VerticalAlignment="Center" />
            <TextBlock x:Name="label2" Grid.Row="1" Text="計測されたBPM" VerticalAlignment="Center" />
            <TextBlock x:Name="label4" Grid.Row="1" Grid.Column="1" Text="0" VerticalAlignment="Center" />
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="2,8,0,0">
                <!-- 押したときに数える（以前と同じく、離したときではない） -->
                <Button x:Name="button1" Content="ビートを打つ" MinWidth="75" Height="23" PreviewMouseLeftButtonDown="Button1_MouseDown" />
                <!-- フォーカスを取らないので、キーはビートを打つボタンに行く -->
                <Button x:Name="button2" Content="クリア" MinWidth="75" Height="23" Margin="54,0,0,0" Focusable="False" Click="Button2_Click" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</forms:DockView>
