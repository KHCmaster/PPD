<forms:DockView x:Class="PPDEditor.IniFileWriter"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:forms="clr-namespace:PPDEditor.Forms"
                xmlns:vm="clr-namespace:PPDEditor.ViewModels.Docks"
                mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:IniFileWriterViewModel}">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <!-- 名前、値、（時間の行は）タイムラインから読み込むボタン。名前の列の幅はそろえる -->
        <ItemsControl x:Name="rowsControl" ItemsSource="{Binding Rows}" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.IsSharedSizeScope="True">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Height="26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Height="22" VerticalContentAlignment="Center" LostKeyboardFocus="ValueBox_LostKeyboardFocus" />
                        <Button Grid.Column="2" Content="{Binding DataContext.Texts[SFWButton], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                Height="22" Margin="4,0,0,0" Padding="4,0,4,0"
                                Command="{Binding DataContext.LoadTimeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTime}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</forms:DockView>
