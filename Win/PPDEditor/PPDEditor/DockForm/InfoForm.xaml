<forms:DockView x:Class="PPDEditor.InfoForm"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:forms="clr-namespace:PPDEditor.Forms">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem x:Name="編集MenuItem" Header="編集" SubmenuOpened="編集MenuItem_SubmenuOpened">
                <MenuItem x:Name="パラメーターMenuItem" Header="パラメーター" Click="パラメーターMenuItem_Click" />
                <MenuItem x:Name="コピーMenuItem" Header="コピー" Click="コピーMenuItem_Click" />
                <MenuItem x:Name="貼り付けMenuItem" Header="貼り付け" Click="貼り付けMenuItem_Click" />
            </MenuItem>
            <MenuItem x:Name="プリセットMenuItem" Header="プリセット" SubmenuOpened="プリセットMenuItem_SubmenuOpened">
                <MenuItem x:Name="読み込みMenuItem" Header="読み込み" />
                <MenuItem x:Name="保存MenuItem" Header="保存" Click="保存MenuItem_Click" />
            </MenuItem>
        </Menu>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="200*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="116*" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="dataGridView1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="None" CanUserResizeColumns="False" CanUserSortColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="Column1" Header="" Binding="{Binding Key}" Width="*" />
                    <DataGridTextColumn x:Name="Column2" Header="" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" />
            <DataGrid x:Name="dataGridView2" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" CanUserSortColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="dataGridViewTextBoxColumn1" Header="キー" Binding="{Binding Key}" Width="*" />
                    <DataGridTextColumn x:Name="dataGridViewTextBoxColumn2" Header="値" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</forms:DockView>
