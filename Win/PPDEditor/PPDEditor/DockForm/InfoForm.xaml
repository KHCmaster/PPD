<forms:DockView x:Class="PPDEditor.InfoForm"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:forms="clr-namespace:PPDEditor.Forms"
                xmlns:vm="clr-namespace:PPDEditor.ViewModels.Docks"
                xmlns:conv="clr-namespace:PPDEditor.Converters"
                mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:InfoViewModel}">
    <forms:DockView.Resources>
        <conv:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </forms:DockView.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{Binding Texts[Edit]}" SubmenuOpened="EditMenu_SubmenuOpened">
                <MenuItem Header="{Binding Texts[Parameter]}" Command="{Binding EditParametersCommand}" />
                <MenuItem Header="{Binding Texts[Copy]}" Command="{Binding CopyCommand}" IsEnabled="{Binding CanCopy}" />
                <MenuItem Header="{Binding Texts[Paste]}" Command="{Binding PasteCommand}" IsEnabled="{Binding CanPaste}" />
            </MenuItem>
            <MenuItem Header="{Binding Texts[Preset]}" SubmenuOpened="PresetMenu_SubmenuOpened">
                <MenuItem Header="{Binding Texts[Load]}" ItemsSource="{Binding PresetNodes}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="ToolTip" Value="{Binding Name}" />
                            <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
                            <Setter Property="Command" Value="{Binding Data.TogglePresetCommand, Source={StaticResource Proxy}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            <Style.Triggers>
                                <!-- 一部のマークにだけ当てはまるプリセットに印を付ける -->
                                <DataTrigger Binding="{Binding IsPartial}" Value="True">
                                    <Setter Property="Icon" Value="－" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                    <MenuItem.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <!-- 名前の「_」がアクセスキーとして扱われないように、TextBlock で表示する -->
                            <TextBlock Text="{Binding Name}" />
                        </HierarchicalDataTemplate>
                    </MenuItem.ItemTemplate>
                </MenuItem>
                <MenuItem Header="{Binding Texts[Save]}" Command="{Binding SavePresetCommand}" />
            </MenuItem>
        </Menu>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="200*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="116*" />
            </Grid.RowDefinitions>
            <DataGrid ItemsSource="{Binding InfoRows}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="None" CanUserResizeColumns="False" CanUserSortColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Key}" Width="*" />
                    <DataGridTextColumn Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" />
            <DataGrid Grid.Row="2" ItemsSource="{Binding Parameters}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" CanUserSortColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding Data.Texts[Key], Source={StaticResource Proxy}}" Binding="{Binding Key}" Width="*" />
                    <DataGridTextColumn Header="{Binding Data.Texts[Value], Source={StaticResource Proxy}}" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</forms:DockView>
