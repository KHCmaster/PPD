<forms:DockView x:Class="PPDEditor.HelpForm"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:forms="clr-namespace:PPDEditor.Forms">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar>
                <TextBox x:Name="toolStripTextBox1" Width="600" KeyDown="ToolStripTextBox1_KeyDown" />
                <Button x:Name="toolStripButton1" IsEnabled="False" Click="ToolStripButton1_Click">
                    <Image Source="/PPDEditor;component/img/back.png" Stretch="None" />
                </Button>
                <Button x:Name="toolStripButton2" IsEnabled="False" Click="ToolStripButton2_Click">
                    <Image Source="/PPDEditor;component/img/next.png" Stretch="None" />
                </Button>
                <!-- 読み込み中に出す -->
                <ProgressBar x:Name="toolStripButton3" Width="23" Height="12" IsIndeterminate="True" Visibility="Collapsed" />
            </ToolBar>
        </ToolBarTray>
        <WebBrowser x:Name="webBrowser1" Navigated="WebBrowser1_Navigated" LoadCompleted="WebBrowser1_LoadCompleted" />
    </DockPanel>
</forms:DockView>
