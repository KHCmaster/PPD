<UserControl x:Class="PPDEditor.Controls.MergeGroupBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="205">
    <GroupBox x:Name="groupBox1" Header="groupBox1">
        <StackPanel Margin="4,2,4,0">
            <DockPanel>
                <Button x:Name="button1" DockPanel.Dock="Right" Content="..." Width="25" Height="22" Margin="3,0,0,0" Click="Button1_Click" />
                <TextBox x:Name="textBox1" Height="20" IsReadOnly="True" VerticalContentAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="label1" Text="マージする難易度" Margin="0,2,0,0" />
            <ComboBox x:Name="comboBox1" Width="121" HorizontalAlignment="Left" Margin="0,2,0,4" />
        </StackPanel>
    </GroupBox>
</UserControl>
