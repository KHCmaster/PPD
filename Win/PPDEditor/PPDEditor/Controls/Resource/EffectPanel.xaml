<UserControl x:Class="PPDEditor.Controls.Resource.EffectPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PPDEditor.Controls.Resource"
             Unloaded="EffectPanel_Unloaded">
    <UserControl.Resources>
        <Style x:Key="ToolButton" TargetType="ButtonBase">
            <Setter Property="Padding" Value="3" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid Background="White">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <!-- 小さいときは真ん中に置く -->
            <local:EffectCanvas x:Name="canvasPanel" Width="256" Height="256" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ScrollViewer>
        <Border x:Name="toolStrip1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30" Padding="2"
                Background="{x:Static SystemColors.ControlBrush}" BorderBrush="{x:Static SystemColors.ControlDarkBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <!-- 再生ボタンと、再生のしかたを選ぶメニュー -->
                <ToggleButton x:Name="toolStripSplitButton1" Style="{StaticResource ToolButton}" Margin="1,0,0,0" Click="ToolStripSplitButton1_Click">
                    <Image x:Name="toolStripSplitButton1Image" Source="/img/playonce.png" Stretch="None" />
                </ToggleButton>
                <Button x:Name="playModeButton" Style="{StaticResource ToolButton}" Margin="0,0,1,0" Padding="1,3" Click="PlayModeButton_Click">
                    <Path Data="M 0 0 L 6 0 L 3 3 Z" Fill="Black" VerticalAlignment="Center" />
                    <Button.ContextMenu>
                        <ContextMenu x:Name="playModeMenu">
                            <MenuItem x:Name="playToolStripMenuItem" Header="1回再生" IsChecked="True" Click="PlayModeMenuItem_Click">
                                <MenuItem.Icon>
                                    <Image Source="/img/playonce.png" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="reversePlayToolStripMenuItem" Header="リバース1回再生" Click="PlayModeMenuItem_Click">
                                <MenuItem.Icon>
                                    <Image Source="/img/playreverse.png" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="loopPlayToolStripMenuItem" Header="ループ再生" Click="PlayModeMenuItem_Click">
                                <MenuItem.Icon>
                                    <Image Source="/img/playloop.png" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="reverseLoopPlayToolStripMenuItem" Header="リバースループ再生" Click="PlayModeMenuItem_Click">
                                <MenuItem.Icon>
                                    <Image Source="/img/playreverseloop.png" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="toolStripButton1" Style="{StaticResource ToolButton}" ToolTip="停止" Click="ToolStripButton1_Click">
                    <Image Source="/img/stop.png" Stretch="None" />
                </Button>
                <ComboBox x:Name="toolStripComboBox1" Width="100" Margin="2,0" VerticalAlignment="Center" ToolTip="キャンバスのサイズ"
                          SelectionChanged="ToolStripComboBox1_SelectionChanged">
                    <ComboBoxItem Content="256 x 256" />
                    <ComboBoxItem Content="384 x 384" />
                    <ComboBoxItem Content="512 x 512" />
                    <ComboBoxItem Content="768 x 768" />
                    <ComboBoxItem Content="1024 x 1024" />
                </ComboBox>
                <ComboBox x:Name="toolStripComboBox2" Width="100" Margin="2,0" VerticalAlignment="Center" ToolTip="キャンバスの背景色"
                          SelectionChanged="ToolStripComboBox2_SelectionChanged" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
