<UserControl x:Class="PPDEditor.Controls.LayerDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="45" MinWidth="238" Focusable="True" Cursor="Hand"
             BorderBrush="Black" BorderThickness="1" Background="LightGray"
             MouseLeftButtonDown="LayerDisplay_MouseLeftButtonDown" ContextMenuOpening="LayerDisplay_ContextMenuOpening">
    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="このレイヤーを削除MenuItem" Header="このレイヤーを削除" Click="このレイヤーを削除MenuItem_Click" />
            <MenuItem x:Name="このレイヤーを複製MenuItem" Header="このレイヤーを複製" Click="このレイヤーを複製MenuItem_Click" />
        </ContextMenu>
    </UserControl.ContextMenu>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="38" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- 表示・非表示の切り替え -->
        <Border x:Name="panel1" Background="{x:Static SystemColors.MenuBrush}" BorderBrush="Black" BorderThickness="0,0,1,0" Cursor="Arrow"
                MouseLeftButtonDown="Panel1_MouseLeftButtonDown">
            <Image x:Name="pictureBox1" Source="/img/eye.png" Width="16" Height="16" Stretch="None" />
        </Border>
        <TextBlock x:Name="label1" Grid.Column="1" Text="layer1" Margin="3,0,0,0" VerticalAlignment="Center" Cursor="Arrow"
                   MouseLeftButtonDown="Label1_MouseLeftButtonDown" />
        <TextBox x:Name="textBox1" Grid.Column="1" Width="107" Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                 Visibility="Collapsed" Cursor="IBeam" KeyDown="TextBox1_KeyDown" LostKeyboardFocus="TextBox1_LostKeyboardFocus" />
        <TextBlock x:Name="label2" Grid.Column="1" Text="BPM" Margin="0,2,5,0" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Arrow" />
        <!-- マークの色。ダブルクリックで変える -->
        <Border x:Name="panel2" Grid.Column="1" Width="19" Height="17" Margin="0,0,5,3" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                BorderBrush="Gray" BorderThickness="1" Cursor="Arrow" MouseLeftButtonDown="Panel2_MouseLeftButtonDown" />
    </Grid>
</UserControl>
