<Window x:Class="PPDEditor.Forms.ChangeKasiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="歌詞を修正する" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="12,7,12,12" Width="268">
        <TextBlock x:Name="label1" Text="修正前" />
        <TextBox x:Name="textBox1" Height="72" Margin="0,4,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        <TextBlock x:Name="label2" Text="↓" HorizontalAlignment="Center" Margin="0,4,0,0" />
        <TextBlock x:Name="label3" Text="修正後" />
        <TextBox x:Name="textBox2" Height="82" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button x:Name="button1" Content="OK" Width="75" Height="23" Click="Button1_Click" />
            <Button x:Name="button2" Content="Cancel" Width="75" Height="23" Margin="26,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
