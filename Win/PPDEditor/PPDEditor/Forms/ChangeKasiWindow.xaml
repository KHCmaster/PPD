<Window x:Class="PPDEditor.Forms.ChangeKasiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PPDEditor.ViewModels.Dialogs"
        xmlns:conv="clr-namespace:PPDEditor.Converters"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ChangeKasiViewModel}"
        Title="{Binding Texts[KEButton4]}" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="12,7,12,12" Width="268">
        <TextBlock Text="{Binding Texts[KEDialogLabel1]}" />
        <TextBox Text="{Binding BeforeText, Mode=OneWay}" Height="72" Margin="0,4,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        <TextBlock Text="{Binding Texts[KEDialogLabel2]}" HorizontalAlignment="Center" Margin="0,4,0,0" />
        <TextBlock Text="{Binding Texts[KEDialogLabel3]}" />
        <TextBox Text="{Binding NewText, UpdateSourceTrigger=PropertyChanged}" Height="82" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="OK" Width="75" Height="23" Command="{Binding OkCommand}" />
            <Button Content="Cancel" Width="75" Height="23" Margin="26,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
