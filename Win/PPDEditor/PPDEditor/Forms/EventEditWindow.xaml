<Window x:Class="PPDEditor.Forms.EventEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PPDEditor.Controls"
        Title="イベント編集" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="VolumeLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="124" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SoundOption" TargetType="CheckBox">
            <Setter Property="Margin" Value="135,0,0,0" />
        </Style>
        <Style x:Key="Block" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>
    <StackPanel>
        <TabControl x:Name="tabControl1" Width="610">
            <TabItem x:Name="tabPage1" Header="サウンド関連">
                <Grid x:Name="soundPanel" Margin="8,4,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Style="{StaticResource Block}">
                        <TextBlock x:Name="label1" Text="動画の音声のボリューム" Style="{StaticResource VolumeLabel}" />
                        <controls:SoundVolumeControl x:Name="soundVolumeControl1" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Style="{StaticResource Block}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="label2" Text="スクエアのボリューム" Style="{StaticResource VolumeLabel}" />
                            <controls:SoundVolumeControl x:Name="soundVolumeControl2" />
                        </StackPanel>
                        <CheckBox x:Name="checkBox2" Content="押している間のみ再生" Style="{StaticResource SoundOption}" />
                        <CheckBox x:Name="checkBox12" Content="長押しリリース時再生" Style="{StaticResource SoundOption}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource Block}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="label3" Text="クロスのボリューム" Style="{StaticResource VolumeLabel}" />
                            <controls:SoundVolumeControl x:Name="soundVolumeControl3" />
                        </StackPanel>
                        <CheckBox x:Name="checkBox3" Content="押している間のみ再生" Style="{StaticResource SoundOption}" />
                        <CheckBox x:Name="checkBox13" Content="長押しリリース時再生" Style="{StaticResource SoundOption}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Style="{StaticResource Block}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="label4" Text="サークルのボリューム" Style="{StaticResource VolumeLabel}" />
                            <controls:SoundVolumeControl x:Name="soundVolumeControl4" />
                        </StackPanel>
                        <CheckBox x:Name="checkBox4" Content="押している間のみ再生" Style="{StaticResource SoundOption}" />
                        <CheckBox x:Name="checkBox14" Content="長押しリリース時再生" Style="{StaticResource SoundOption}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Style="{StaticResource Block}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="label5" Text="トライアングルのボリューム" Style="{StaticResource VolumeLabel}" />
                            <controls:SoundVolumeControl x:Name="soundVolumeControl5" />
                        </StackPanel>
                        <CheckBox x:Name="checkBox5" Content="押している間のみ再生" Style="{StaticResource SoundOption}" />
                        <CheckBox x:Name="checkBox15" Content="長押しリリース時再生" Style="{StaticResource SoundOption}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Style="{StaticResource Block}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="label6" Text="レフトのボリューム" Style="{StaticResource VolumeLabel}" />
                            <controls:SoundVolumeControl x:Name="soundVolumeControl6" />
                        </StackPanel>
                        <CheckBox x:Name="checkBox6" Content="押している間のみ再生" Style="{StaticResource SoundOption}" />
                        <CheckBox x:Name="checkBox16" Content="長押しリリース時再生" Style="{StaticResource SoundOption}" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Style="{StaticResource Block}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="label7" Text="ダウンのボリューム" Style="{StaticResource VolumeLabel}" />
                            <controls:SoundVolumeControl x:Name="soundVolumeControl7" />
                        </StackPanel>
                        <CheckBox x:Name="checkBox7" Content="押している間のみ再生" Style="{StaticResource SoundOption}" />
                        <CheckBox x:Name="checkBox17" Content="長押しリリース時再生" Style="{StaticResource SoundOption}" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Style="{StaticResource Block}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="label8" Text="ライトのボリューム" Style="{StaticResource VolumeLabel}" />
                            <controls:SoundVolumeControl x:Name="soundVolumeControl8" />
                        </StackPanel>
                        <CheckBox x:Name="checkBox8" Content="押している間のみ再生" Style="{StaticResource SoundOption}" />
                        <CheckBox x:Name="checkBox18" Content="長押しリリース時再生" Style="{StaticResource SoundOption}" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="1" Style="{StaticResource Block}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="label9" Text="アップのボリューム" Style="{StaticResource VolumeLabel}" />
                            <controls:SoundVolumeControl x:Name="soundVolumeControl9" />
                        </StackPanel>
                        <CheckBox x:Name="checkBox9" Content="押している間のみ再生" Style="{StaticResource SoundOption}" />
                        <CheckBox x:Name="checkBox19" Content="長押しリリース時再生" Style="{StaticResource SoundOption}" />
                    </StackPanel>

                    <StackPanel Grid.Row="5" Style="{StaticResource Block}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="label10" Text="アールのボリューム" Style="{StaticResource VolumeLabel}" />
                            <controls:SoundVolumeControl x:Name="soundVolumeControl10" />
                        </StackPanel>
                        <CheckBox x:Name="checkBox10" Content="押している間のみ再生" Style="{StaticResource SoundOption}" />
                        <CheckBox x:Name="checkBox20" Content="長押しリリース時再生" Style="{StaticResource SoundOption}" />
                    </StackPanel>
                    <StackPanel Grid.Row="5" Grid.Column="1" Style="{StaticResource Block}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="label11" Text="エルのボリューム" Style="{StaticResource VolumeLabel}" />
                            <controls:SoundVolumeControl x:Name="soundVolumeControl11" />
                        </StackPanel>
                        <CheckBox x:Name="checkBox11" Content="押している間のみ再生" Style="{StaticResource SoundOption}" />
                        <CheckBox x:Name="checkBox21" Content="長押しリリース時再生" Style="{StaticResource SoundOption}" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="tabPage2" Header="その他">
                <StackPanel x:Name="otherPanel" Margin="6,4,6,0">
                    <StackPanel Orientation="Horizontal">
                        <GroupBox x:Name="groupBox1" Header="BPM変更" Width="147" Height="88">
                            <Grid Margin="2,2,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="47" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="label12" Text="変更前" VerticalAlignment="Center" />
                                <TextBox x:Name="textBox1" Grid.Column="2" Height="20" IsEnabled="False" VerticalContentAlignment="Center" />
                                <TextBlock x:Name="label13" Grid.Row="1" Text="変更後" VerticalAlignment="Center" />
                                <!-- 数値でないときに出す -->
                                <Image x:Name="pictureBox1" Grid.Row="1" Grid.Column="1" Source="/PPDEditor;component/img/alert.png" Width="16" Height="16" Visibility="Hidden" />
                                <TextBox x:Name="textBox2" Grid.Row="1" Grid.Column="2" Height="20" VerticalContentAlignment="Center" TextChanged="TextBox2_TextChanged" />
                                <CheckBox x:Name="checkBox1" Grid.Row="2" Grid.ColumnSpan="3" Content="瞬時に変化" Margin="0,4,0,0" />
                            </Grid>
                        </GroupBox>
                        <GroupBox x:Name="groupBox2" Header="マークエフェクト" Width="94" Height="88" Margin="6,0,0,0">
                            <StackPanel Margin="2,4,0,0">
                                <RadioButton x:Name="radioButton1" GroupName="DisplayState" Content="なし" />
                                <RadioButton x:Name="radioButton2" GroupName="DisplayState" Content="サドゥン" Margin="0,5,0,0" />
                                <RadioButton x:Name="radioButton3" GroupName="DisplayState" Content="ヒドゥン" Margin="0,5,0,0" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox x:Name="groupBox3" Header="マークの動き" Width="80" Height="88" Margin="6,0,0,0">
                            <StackPanel Margin="2,14,0,0">
                                <RadioButton x:Name="radioButton4" GroupName="MoveState" Content="普通" />
                                <RadioButton x:Name="radioButton5" GroupName="MoveState" Content="停止" Margin="0,5,0,0" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox x:Name="groupBox4" Header="AC" Width="72" Height="88" Margin="6,0,0,0">
                            <StackPanel Margin="8,4,0,0">
                                <RadioButton x:Name="radioButton6" GroupName="NoteType" Content="普通" />
                                <RadioButton x:Name="radioButton7" GroupName="NoteType" Content="AC" Margin="0,5,0,0" />
                                <RadioButton x:Name="radioButton11" GroupName="NoteType" Content="ACFT" Margin="0,5,0,0" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox x:Name="groupBox6" Header="スライド" Width="169" Height="88" Margin="6,0,0,0">
                            <DockPanel Margin="2,4,2,0" VerticalAlignment="Top">
                                <TextBox x:Name="textBox3" DockPanel.Dock="Right" Width="47" Height="20" VerticalContentAlignment="Center" />
                                <TextBlock x:Name="label14" Text="スケール" VerticalAlignment="Center" />
                            </DockPanel>
                        </GroupBox>
                    </StackPanel>
                    <GroupBox x:Name="groupBox5" Header="同時押し描画順序" Width="245" Height="194" HorizontalAlignment="Left" Margin="2,6,0,0">
                        <Grid Margin="4,4,4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="131" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <RadioButton x:Name="radioButton8" GroupName="InitializeOrder" Content="普通" Checked="InitializeOrderChanged" />
                                <RadioButton x:Name="radioButton9" GroupName="InitializeOrder" Content="AC" Margin="0,5,0,0" Checked="InitializeOrderChanged" />
                                <RadioButton x:Name="radioButton10" GroupName="InitializeOrder" Content="カスタム" Margin="0,5,0,0" Checked="InitializeOrderChanged" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Bottom">
                                <Button x:Name="button3" Content="上へ" Width="75" Height="23" HorizontalAlignment="Left" IsEnabled="False" Click="Button3_Click" />
                                <Button x:Name="button4" Content="下へ" Width="75" Height="23" HorizontalAlignment="Left" Margin="0,6,0,0" IsEnabled="False" Click="Button4_Click" />
                            </StackPanel>
                            <ListBox x:Name="listBox1" Grid.Column="1" />
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </TabItem>
        </TabControl>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,14">
            <Button x:Name="button1" Content="OK" Width="75" Height="23" IsDefault="True" Click="Button1_Click" />
            <Button x:Name="button2" Content="Cancel" Width="75" Height="23" Margin="141,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
