<Window x:Class="PPDEditor.Forms.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SplashForm" Width="600" Height="350" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/PPDEditor;component/img/splash.png" Stretch="Fill" />
        </Grid.Background>
        <TextBlock x:Name="statusLabel" Text="label1" Foreground="White" Margin="12,0,0,9" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
        <TextBlock x:Name="versionLabel" Text="label2" Foreground="White" Margin="0,0,12,9" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
    </Grid>
</Window>
