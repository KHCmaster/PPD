<Window x:Class="PPDEditor.Forms.EditTimeLineRowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <DataGrid x:Name="dataGridView1" Width="290" Height="253" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                  HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="Column1" Header="Kind" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                <!-- 1 回のクリックで切り替わるように、セルの中に直接チェックボックスを置く -->
                <DataGridTemplateColumn x:Name="Column2" Header="Visible" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsVisible, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button x:Name="button3" Content="上へ移動" MinWidth="75" Height="23" Click="Button3_Click" />
            <Button x:Name="button4" Content="下へ移動" MinWidth="75" Height="23" Margin="6,0,0,0" Click="Button4_Click" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button x:Name="button1" Content="OK" Width="75" Height="23" IsDefault="True" Click="Button1_Click" />
            <Button x:Name="button2" Content="Cancel" Width="75" Height="23" Margin="18,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
