<Window x:Class="PPDEditor.Forms.NewLayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新規レイヤー" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" FocusManager.FocusedElement="{Binding ElementName=textBox1}">
    <StackPanel Margin="12,6,12,12" Width="218">
        <TextBlock x:Name="label1" Text="レイヤー名：" />
        <TextBox x:Name="textBox1" Height="20" Margin="0,3,0,0" VerticalContentAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
            <!-- テキストボックスで Enter を押すと OK になる（以前と同じ） -->
            <Button x:Name="button1" Content="OK" Width="75" Height="23" IsDefault="True" Click="Button1_Click" />
            <Button x:Name="button2" Content="Cancel" Width="75" Height="23" Margin="19,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
