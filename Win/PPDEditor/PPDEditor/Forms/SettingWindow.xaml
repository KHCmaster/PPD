<Window x:Class="PPDEditor.Forms.SettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PPDEditor.Controls"
        Title="" Width="471" Height="419" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="controls:NumericUpDown">
            <Setter Property="Width" Value="52" />
        </Style>
        <Style x:Key="NumberLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="129" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListBox x:Name="listBox1" SelectionChanged="ListBox1_SelectedIndexChanged">
            <ListBoxItem Content="一般" />
            <ListBoxItem Content="ショートカットキー" />
            <ListBoxItem Content="環境変数" />
        </ListBox>
        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,12">
                <Button x:Name="button1" Content="OK" Width="75" Height="23" Click="Button1_Click" />
                <Button x:Name="button2" Content="Cancel" Width="75" Height="23" Margin="18,0,0,0" IsCancel="True" />
            </StackPanel>
            <Grid>
                <!-- 一般 -->
                <StackPanel x:Name="generalPanel" Margin="19,17,12,0">
                    <TextBlock x:Name="label1" Text="作者名" />
                    <TextBox x:Name="textBox1" Height="20" Margin="2,3,0,0" VerticalContentAlignment="Center" TextChanged="TextBox1_TextChanged" />
                    <TextBlock x:Name="label2" Text="動画遅延時間" Margin="0,8,0,0" />
                    <TextBox x:Name="textBox2" Height="20" Margin="2,3,0,0" VerticalContentAlignment="Center" TextChanged="TextBox2_TextChanged" />
                    <CheckBox x:Name="checkBox3" Margin="2,12,0,0">
                        <TextBlock Text="マークを１つだけ選択しているときのタイプ変更、時間変更を同時にできるようにする" TextWrapping="Wrap" />
                    </CheckBox>
                </StackPanel>
                <!-- ショートカットキー -->
                <DockPanel x:Name="shortcutPanel" Visibility="Collapsed">
                    <Grid DockPanel.Dock="Bottom" Margin="7,3,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button x:Name="button4" Content="コマンドを追加" Height="23" Click="Button4_Click" />
                        <Button x:Name="button5" Grid.Column="1" Content="コマンドを削除" Height="23" Margin="6,0,0,0" IsEnabled="False" Click="Button5_Click" />
                        <!-- 押したキーをショートカットにする -->
                        <TextBox x:Name="textBox3" Grid.Row="1" Height="22" Margin="0,3,0,0" IsEnabled="False" IsReadOnly="True" VerticalContentAlignment="Center"
                                 PreviewKeyDown="TextBox3_PreviewKeyDown" LostKeyboardFocus="TextBox3_LostKeyboardFocus" />
                        <Button x:Name="button3" Grid.Row="1" Grid.Column="1" Content="ショートカットを削除" Height="23" Margin="6,3,0,0" Click="Button3_Click" />
                    </Grid>
                    <DataGrid x:Name="dataGridView1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                              HeadersVisibility="Column" CanUserSortColumns="False" SelectionChanged="DataGridView1_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="Column1" Header="Command" Binding="{Binding Command}" Width="*" />
                            <DataGridTextColumn x:Name="Column2" Header="Key" Binding="{Binding Key}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <!-- 環境変数 -->
                <StackPanel x:Name="variablePanel" Visibility="Collapsed" Margin="7,3,12,0">
                    <GroupBox x:Name="groupBox1" Header="マークの移動">
                        <Grid Margin="4,2,4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="moveLabel1" Text="移動量1" Style="{StaticResource NumberLabel}" />
                            <controls:NumericUpDown x:Name="move1" Grid.Column="1" Minimum="1" Maximum="400" />
                            <TextBlock x:Name="moveLabel2" Grid.Row="1" Text="移動量2" Style="{StaticResource NumberLabel}" />
                            <controls:NumericUpDown x:Name="move2" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="400" />
                            <TextBlock x:Name="moveLabel3" Grid.Row="2" Text="移動量3" Style="{StaticResource NumberLabel}" />
                            <controls:NumericUpDown x:Name="move3" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="400" />
                            <TextBlock x:Name="moveLabel4" Grid.Row="3" Text="移動量4" Style="{StaticResource NumberLabel}" />
                            <controls:NumericUpDown x:Name="move4" Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="400" />
                            <TextBlock x:Name="moveLabel5" Grid.Column="2" Text="移動量5" Style="{StaticResource NumberLabel}" Margin="18,0,6,0" />
                            <controls:NumericUpDown x:Name="move5" Grid.Column="3" Minimum="1" Maximum="400" />
                            <TextBlock x:Name="moveLabel6" Grid.Row="1" Grid.Column="2" Text="移動量6" Style="{StaticResource NumberLabel}" Margin="18,0,6,0" />
                            <controls:NumericUpDown x:Name="move6" Grid.Row="1" Grid.Column="3" Minimum="1" Maximum="400" />
                            <TextBlock x:Name="moveLabel7" Grid.Row="2" Grid.Column="2" Text="移動量7" Style="{StaticResource NumberLabel}" Margin="18,0,6,0" />
                            <controls:NumericUpDown x:Name="move7" Grid.Row="2" Grid.Column="3" Minimum="1" Maximum="400" />
                            <TextBlock x:Name="moveLabel8" Grid.Row="3" Grid.Column="2" Text="移動量8" Style="{StaticResource NumberLabel}" Margin="18,0,6,0" />
                            <controls:NumericUpDown x:Name="move8" Grid.Row="3" Grid.Column="3" Minimum="1" Maximum="400" />
                        </Grid>
                    </GroupBox>
                    <GroupBox x:Name="groupBox2" Header="マークの角度" Margin="0,6,0,0">
                        <StackPanel Margin="4,2,4,2">
                            <TextBlock x:Name="label6" Text="ドラッグの角度制限(0:なし)" />
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="50" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" MinWidth="100" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="24" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="label13" Text="なし" Style="{StaticResource NumberLabel}" />
                                <controls:NumericUpDown x:Name="angle1" Grid.Column="1" Minimum="0" Maximum="90" />
                                <TextBlock x:Name="label14" Grid.Row="1" Text="Shift" Style="{StaticResource NumberLabel}" />
                                <controls:NumericUpDown x:Name="angle2" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="90" />
                                <TextBlock x:Name="label15" Grid.Row="2" Text="Control" Style="{StaticResource NumberLabel}" />
                                <controls:NumericUpDown x:Name="angle3" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="90" />
                                <TextBlock x:Name="label16" Grid.Row="3" Text="Alt" Style="{StaticResource NumberLabel}" />
                                <controls:NumericUpDown x:Name="angle4" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="90" />
                                <TextBlock x:Name="label17" Grid.Column="2" Text="Shift+Control" Style="{StaticResource NumberLabel}" Margin="16,0,6,0" />
                                <controls:NumericUpDown x:Name="angle5" Grid.Column="3" Minimum="0" Maximum="90" />
                                <TextBlock x:Name="label18" Grid.Row="1" Grid.Column="2" Text="Shift+Alt" Style="{StaticResource NumberLabel}" Margin="16,0,6,0" />
                                <controls:NumericUpDown x:Name="angle6" Grid.Row="1" Grid.Column="3" Minimum="0" Maximum="90" />
                                <TextBlock x:Name="label19" Grid.Row="2" Grid.Column="2" Text="Control+Alt" Style="{StaticResource NumberLabel}" Margin="16,0,6,0" />
                                <controls:NumericUpDown x:Name="angle7" Grid.Row="2" Grid.Column="3" Minimum="0" Maximum="90" />
                                <TextBlock x:Name="label20" Grid.Row="3" Grid.Column="2" Text="Shift+Control+Alt" Style="{StaticResource NumberLabel}" Margin="16,0,6,0" />
                                <controls:NumericUpDown x:Name="angle8" Grid.Row="3" Grid.Column="3" Minimum="0" Maximum="90" />
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox x:Name="groupBox3" Header="トグルオプション" Margin="0,6,0,0">
                        <StackPanel Margin="4,3,4,2">
                            <CheckBox x:Name="checkBox1" Content="矢印を表示" />
                            <CheckBox x:Name="checkBox2" Content="矩形を表示" Margin="0,4,0,0" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
