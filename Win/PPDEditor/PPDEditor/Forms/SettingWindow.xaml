<Window x:Class="PPDEditor.Forms.SettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PPDEditor.Controls"
        xmlns:vm="clr-namespace:PPDEditor.ViewModels.Dialogs"
        xmlns:conv="clr-namespace:PPDEditor.Converters"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:SettingViewModel}"
        Title="{Binding Texts[Setting]}" Width="471" Height="419" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <Style TargetType="controls:NumericUpDown">
            <Setter Property="Width" Value="52" />
        </Style>
        <Style x:Key="NumberLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="RightNumberLabel" TargetType="TextBlock" BasedOn="{StaticResource NumberLabel}">
            <Setter Property="Margin" Value="18,0,6,0" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="129" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListBox SelectedIndex="{Binding PageIndex}">
            <ListBoxItem Content="{Binding Texts[General]}" />
            <ListBoxItem Content="{Binding Texts[ShortcutKey]}" />
            <ListBoxItem Content="{Binding Texts[EnvironmentVariable]}" />
        </ListBox>
        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,12">
                <Button Content="OK" Width="75" Height="23" Command="{Binding OkCommand}" />
                <Button Content="Cancel" Width="75" Height="23" Margin="18,0,0,0" IsCancel="True" />
            </StackPanel>
            <Grid>
                <!-- 一般 -->
                <StackPanel Margin="19,17,12,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PageIndex}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding Texts[SFAutherName]}" />
                    <TextBox Text="{Binding AuthorName, UpdateSourceTrigger=PropertyChanged}" Height="20" Margin="2,3,0,0" VerticalContentAlignment="Center" />
                    <TextBlock Text="{Binding Texts[SFMovieLatency]}" Margin="0,8,0,0" />
                    <TextBox Text="{Binding MovieLatency, UpdateSourceTrigger=PropertyChanged}" Height="20" Margin="2,3,0,0" VerticalContentAlignment="Center" />
                    <CheckBox IsChecked="{Binding EnableToChangeMarkTypeAndTime}" Margin="2,12,0,0">
                        <TextBlock Text="{Binding Texts[SFCheckBox3]}" TextWrapping="Wrap" />
                    </CheckBox>
                </StackPanel>
                <!-- ショートカットキー -->
                <DockPanel>
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PageIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <Grid DockPanel.Dock="Bottom" Margin="7,3,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Content="{Binding Texts[AddCommand]}" Height="23" Command="{Binding AddCommandCommand}" />
                        <Button Grid.Column="1" Content="{Binding Texts[RemoveCommand]}" Height="23" Margin="6,0,0,0" Command="{Binding RemoveCommandCommand}" />
                        <!-- 押したキーをショートカットにする（コマンドを選んだときだけ入力できる） -->
                        <TextBox x:Name="keyBox" Grid.Row="1" Text="{Binding EditingKey, Mode=OneWay}" Height="22" Margin="0,3,0,0" IsEnabled="False" IsReadOnly="True" VerticalContentAlignment="Center"
                                 PreviewKeyDown="KeyBox_PreviewKeyDown" LostKeyboardFocus="KeyBox_LostKeyboardFocus" />
                        <Button Grid.Row="1" Grid.Column="1" Content="{Binding Texts[DeleteShortcut]}" Height="23" Margin="6,3,0,0" Command="{Binding DeleteShortcutCommand}" />
                    </Grid>
                    <DataGrid x:Name="shortcutGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                              HeadersVisibility="Column" CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding Data.Texts[Command], Source={StaticResource Proxy}}" Binding="{Binding Command}" Width="*" />
                            <DataGridTextColumn Header="{Binding Data.Texts[Key], Source={StaticResource Proxy}}" Binding="{Binding Key}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <!-- 環境変数 -->
                <StackPanel Margin="7,3,12,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PageIndex}" Value="2">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <GroupBox Header="{Binding Texts[SFGroupBox1]}">
                        <Grid Margin="4,2,4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Texts[Move1]}" Style="{StaticResource NumberLabel}" />
                            <controls:NumericUpDown Grid.Column="1" Minimum="1" Maximum="400" Value="{Binding Moves[0]}" />
                            <TextBlock Grid.Row="1" Text="{Binding Texts[Move2]}" Style="{StaticResource NumberLabel}" />
                            <controls:NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="400" Value="{Binding Moves[1]}" />
                            <TextBlock Grid.Row="2" Text="{Binding Texts[Move3]}" Style="{StaticResource NumberLabel}" />
                            <controls:NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="400" Value="{Binding Moves[2]}" />
                            <TextBlock Grid.Row="3" Text="{Binding Texts[Move4]}" Style="{StaticResource NumberLabel}" />
                            <controls:NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="400" Value="{Binding Moves[3]}" />
                            <TextBlock Grid.Column="2" Text="{Binding Texts[Move5]}" Style="{StaticResource RightNumberLabel}" />
                            <controls:NumericUpDown Grid.Column="3" Minimum="1" Maximum="400" Value="{Binding Moves[4]}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Texts[Move6]}" Style="{StaticResource RightNumberLabel}" />
                            <controls:NumericUpDown Grid.Row="1" Grid.Column="3" Minimum="1" Maximum="400" Value="{Binding Moves[5]}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Texts[Move7]}" Style="{StaticResource RightNumberLabel}" />
                            <controls:NumericUpDown Grid.Row="2" Grid.Column="3" Minimum="1" Maximum="400" Value="{Binding Moves[6]}" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Texts[Move8]}" Style="{StaticResource RightNumberLabel}" />
                            <controls:NumericUpDown Grid.Row="3" Grid.Column="3" Minimum="1" Maximum="400" Value="{Binding Moves[7]}" />
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="{Binding Texts[SFGroupBox2]}" Margin="0,6,0,0">
                        <StackPanel Margin="4,2,4,2">
                            <TextBlock Text="{Binding Texts[DragAngleRestriction]}" />
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="50" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" MinWidth="100" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="24" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Texts[None]}" Style="{StaticResource NumberLabel}" />
                                <controls:NumericUpDown Grid.Column="1" Minimum="0" Maximum="90" Value="{Binding Angles[0]}" />
                                <TextBlock Grid.Row="1" Text="Shift" Style="{StaticResource NumberLabel}" />
                                <controls:NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="90" Value="{Binding Angles[1]}" />
                                <TextBlock Grid.Row="2" Text="Control" Style="{StaticResource NumberLabel}" />
                                <controls:NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="90" Value="{Binding Angles[2]}" />
                                <TextBlock Grid.Row="3" Text="Alt" Style="{StaticResource NumberLabel}" />
                                <controls:NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="90" Value="{Binding Angles[3]}" />
                                <TextBlock Grid.Column="2" Text="Shift+Control" Style="{StaticResource NumberLabel}" Margin="16,0,6,0" />
                                <controls:NumericUpDown Grid.Column="3" Minimum="0" Maximum="90" Value="{Binding Angles[4]}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Shift+Alt" Style="{StaticResource NumberLabel}" Margin="16,0,6,0" />
                                <controls:NumericUpDown Grid.Row="1" Grid.Column="3" Minimum="0" Maximum="90" Value="{Binding Angles[5]}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Control+Alt" Style="{StaticResource NumberLabel}" Margin="16,0,6,0" />
                                <controls:NumericUpDown Grid.Row="2" Grid.Column="3" Minimum="0" Maximum="90" Value="{Binding Angles[6]}" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Shift+Control+Alt" Style="{StaticResource NumberLabel}" Margin="16,0,6,0" />
                                <controls:NumericUpDown Grid.Row="3" Grid.Column="3" Minimum="0" Maximum="90" Value="{Binding Angles[7]}" />
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="{Binding Texts[ToggleOption]}" Margin="0,6,0,0">
                        <StackPanel Margin="4,3,4,2">
                            <CheckBox Content="{Binding Texts[SFCheckBox1]}" IsChecked="{Binding ShowToggleArrow}" />
                            <CheckBox Content="{Binding Texts[SFCheckBox2]}" IsChecked="{Binding ShowToggleRectangle}" Margin="0,4,0,0" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
