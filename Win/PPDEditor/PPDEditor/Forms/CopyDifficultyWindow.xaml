<Window x:Class="PPDEditor.Forms.CopyDifficultyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="難易度をコピー" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="12,9,12,12" MinWidth="205">
        <TextBlock x:Name="label1" Text="コピー先の難易度を選択してください" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock x:Name="label2" Text="現在の難易度" />
            <TextBlock x:Name="label3" Margin="44,0,0,0" />
        </StackPanel>
        <ComboBox x:Name="comboBox1" Width="121" HorizontalAlignment="Left" Margin="27,4,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button x:Name="button1" Content="OK" Width="75" Height="23" IsDefault="True" Click="Button1_Click" />
            <Button x:Name="button2" Content="Cancel" Width="75" Height="23" Margin="21,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
