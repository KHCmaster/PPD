<Window x:Class="PPDEditor.Forms.PublishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="発行" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="10,9,12,12" Width="484">
        <TextBlock x:Name="label1" Text="指定したフォルダに譜面フォルダを発行します" />
        <TextBlock x:Name="label2" Text="フォルダ" Margin="0,8,0,0" />
        <DockPanel Margin="2,3,0,0">
            <Button x:Name="button3" DockPanel.Dock="Right" Content="..." Width="25" Height="22" Margin="12,0,0,0" Click="Button3_Click" />
            <TextBox x:Name="textBox1" Height="20" IsReadOnly="True" VerticalContentAlignment="Center" />
        </DockPanel>
        <Grid Margin="2,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="253" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox x:Name="groupBox1" Header="発行する難易度">
                <StackPanel Orientation="Horizontal" Margin="3,3,0,2">
                    <CheckBox x:Name="checkBox1" Content="Easy" Click="CheckBox_Click" />
                    <CheckBox x:Name="checkBox2" Content="Normal" Margin="8,0,0,0" Click="CheckBox_Click" />
                    <CheckBox x:Name="checkBox3" Content="Hard" Margin="8,0,0,0" Click="CheckBox_Click" />
                    <CheckBox x:Name="checkBox4" Content="Extreme" Margin="8,0,0,0" Click="CheckBox_Click" />
                </StackPanel>
            </GroupBox>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock x:Name="label3" Text="発行フォルダ名" />
                <TextBox x:Name="textBox2" Height="20" Margin="0,4,0,0" VerticalContentAlignment="Center" TextChanged="TextBox2_TextChanged" />
            </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button x:Name="button1" Content="OK" Width="75" Height="23" Click="Button1_Click" />
            <Button x:Name="button2" Content="Cancel" Width="75" Height="23" Margin="68,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
