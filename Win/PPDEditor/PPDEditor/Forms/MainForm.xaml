<Window x:Class="PPDEditor.Forms.EditorForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:controls="clr-namespace:PPDEditor.Controls"
        Title="PPDEditor" Width="1008" Height="820" Icon="/ed.ico"
        AllowDrop="True" DragEnter="Form1_DragEnter" DragOver="Form1_DragEnter" Drop="Form1_DragDrop"
        Closing="Form1_FormClosing" Loaded="MainForm_Load" SourceInitialized="Window_SourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ToolImageButton" TargetType="ButtonBase">
            <Setter Property="Padding" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DropDownArrow" TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
            <Setter Property="Padding" Value="1,2" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>
    <Grid x:Name="rootGrid">
        <!-- スキンの背景 -->
        <Rectangle x:Name="backgroundFill" />
        <Image x:Name="backgroundImage" Stretch="Uniform" StretchDirection="Both" />
        <DockPanel>
            <Grid DockPanel.Dock="Top">
                <Rectangle x:Name="topOverlay" />
                <StackPanel>
                    <Menu x:Name="menuStrip1" Background="Transparent">
                        <MenuItem x:Name="ファイルToolStripMenuItem" Header="ファイル">
                            <MenuItem x:Name="新規プロジェクトを作成ToolStripMenuItem" Header="新規プロジェクトを作成" Click="新規プロジェクトを作成ToolStripMenuItem_Click" />
                            <MenuItem x:Name="プロジェクトを開くToolStripMenuItem" Header="プロジェクトを開く" Click="プロジェクトを開くToolStripMenuItem_Click" />
                            <MenuItem x:Name="プロジェクトを上書き保存ToolStripMenuItem" Header="プロジェクトを上書き保存" InputGestureText="Ctrl+S" IsEnabled="False" Click="プロジェクトを上書き保存ToolStripMenuItem_Click" />
                            <MenuItem x:Name="プロジェクトをマージToolStripMenuItem" Header="プロジェクトをマージ" Click="プロジェクトをマージToolStripMenuItem_Click" />
                            <MenuItem x:Name="開くToolStripMenuItem" Header="開く">
                                <MenuItem x:Name="ppdToolStripMenuItem" Header="*.ppd" Click="PpdToolStripMenuItem_Click" />
                                <MenuItem x:Name="movieToolStripMenuItem" Header="movie.*" Click="MovieToolStripMenuItem_Click" />
                                <MenuItem x:Name="kasitxtToolStripMenuItem1" Header="kasi.txt" Click="KasitxtToolStripMenuItem1_Click" />
                                <MenuItem x:Name="datainiToolStripMenuItem1" Header="data.ini" IsEnabled="False" Click="DatainiToolStripMenuItem1_Click" />
                                <MenuItem x:Name="evdToolStripMenuItem1" Header="*.evd" Click="EvdToolStripMenuItem1_Click" />
                            </MenuItem>
                            <MenuItem x:Name="保存ToolStripMenuItem" Header="保存">
                                <MenuItem x:Name="ppdToolStripMenuItem1" Header="*.ppd" Click="PpdToolStripMenuItem1_Click" />
                                <MenuItem x:Name="kasitxtToolStripMenuItem" Header="kasi.txt" Click="KasitxtToolStripMenuItem_Click" />
                                <MenuItem x:Name="soundsettxtToolStripMenuItem" Header="soundset.txt" Click="SoundsettxtToolStripMenuItem_Click" />
                                <MenuItem x:Name="scdToolStripMenuItem" Header="*.scd" Click="ScdToolStripMenuItem_Click" />
                                <MenuItem x:Name="datainiToolStripMenuItem" Header="data.ini" IsEnabled="False" Click="DatainiToolStripMenuItem_Click" />
                                <MenuItem x:Name="evdToolStripMenuItem" Header="*.evd" Click="EvdToolStripMenuItem_Click" />
                            </MenuItem>
                            <MenuItem x:Name="インポートToolStripMenuItem" Header="インポート">
                                <MenuItem x:Name="イベントToolStripMenuItem" Header="イベント" SubmenuOpened="イベントToolStripMenuItem_DropDownOpening">
                                    <MenuItem x:Name="easyToolStripMenuItem1" Header="Easy" Click="EasyToolStripMenuItem1_Click" />
                                    <MenuItem x:Name="normalToolStripMenuItem1" Header="Normal" Click="NormalToolStripMenuItem1_Click" />
                                    <MenuItem x:Name="hardToolStripMenuItem1" Header="Hard" Click="HardToolStripMenuItem1_Click" />
                                    <MenuItem x:Name="extremeToolStripMenuItem1" Header="Extreme" Click="ExtremeToolStripMenuItem1_Click" />
                                    <MenuItem x:Name="baseToolStripMenuItem1" Header="Base" Click="BaseToolStripMenuItem1_Click" />
                                    <MenuItem x:Name="別のファイルToolStripMenuItem" Header="別のファイル" Click="別のファイルToolStripMenuItem_Click" />
                                </MenuItem>
                            </MenuItem>
                            <MenuItem x:Name="発行ToolStripMenuItem" Header="発行" IsEnabled="False" Click="発行ToolStripMenuItem_Click" />
                            <MenuItem x:Name="mODを発行ToolStripMenuItem" Header="MODを発行" IsEnabled="False" Click="MODを発行ToolStripMenuItem_Click" />
                            <Separator />
                            <MenuItem x:Name="最近使用したプロジェクトToolStripMenuItem" Header="最近使用したプロジェクト" />
                            <MenuItem x:Name="終了ToolStripMenuItem" Header="終了" Click="終了ToolStripMenuItem_Click" />
                        </MenuItem>
                        <MenuItem x:Name="編集ToolStripMenuItem" Header="編集">
                            <MenuItem x:Name="元に戻すToolStripMenuItem" Header="元に戻す" Click="元に戻すToolStripMenuItem_Click" />
                            <MenuItem x:Name="やり直すToolStripMenuItem" Header="やり直す" Click="やり直すToolStripMenuItem_Click" />
                            <MenuItem x:Name="ライン入れ替えToolStripMenuItem" Header="ライン入れ替え" Click="ライン入れ替えToolStripMenuItem_Click" />
                            <MenuItem x:Name="強制的にラインに乗せるToolStripMenuItem" Header="強制的にラインに乗せる">
                                <MenuItem x:Name="レイヤー全体ToolStripMenuItem" Header="レイヤー全体" Click="シート全体ToolStripMenuItem_Click" />
                                <MenuItem x:Name="選択範囲のみToolStripMenuItem" Header="選択範囲のみ" Click="選択範囲のみToolStripMenuItem_Click" />
                            </MenuItem>
                        </MenuItem>
                        <MenuItem x:Name="コマンドToolStripMenuItem" Header="コマンド">
                            <Separator />
                            <MenuItem x:Name="一覧を再読み込みToolStripMenuItem" Header="一覧を再読み込み" Click="一覧を再読み込みToolStripMenuItem_Click" />
                        </MenuItem>
                        <MenuItem x:Name="動画ToolStripMenuItem" Header="動画">
                            <MenuItem x:Name="再生ToolStripMenuItem" Header="再生" Click="再生ToolStripMenuItem_Click" />
                            <MenuItem x:Name="一時停止ToolStripMenuItem" Header="一時停止" Click="一時停止ToolStripMenuItem_Click" />
                            <MenuItem x:Name="停止ToolStripMenuItem" Header="停止" Click="停止ToolStripMenuItem_Click" />
                            <MenuItem x:Name="打鍵記録ToolStripMenuItem" Header="打鍵記録" Click="打鍵記録ToolStripMenuItem_Click" />
                            <MenuItem x:Name="切り取りToolStripMenuItem" Header="切り取り" Click="切り取りToolStripMenuItem_Click" />
                        </MenuItem>
                        <MenuItem x:Name="表示ToolStripMenuItem" Header="表示" SubmenuOpened="表示ToolStripMenuItem_SubmenuOpened">
                            <MenuItem x:Name="ゲームウィンドウToolStripMenuItem" Header="ゲームウィンドウ" Click="ゲームウィンドウToolStripMenuItem_Click" />
                            <MenuItem x:Name="タイムラインウィンドウToolStripMenuItem" Header="タイムラインウィンドウ" Click="タイムラインウィンドウToolStripMenuItem_Click" />
                            <MenuItem x:Name="プロパティウィンドウToolStripMenuItem" Header="プロパティウィンドウ" Click="プロパティウィンドウToolStripMenuItem_Click" />
                            <MenuItem x:Name="位置角度ローダーセーバーToolStripMenuItem" Header="位置角度ローダーセーバー" Click="位置角度ローダーセーバーToolStripMenuItem_Click" />
                            <MenuItem x:Name="歌詞エディターToolStripMenuItem" Header="歌詞エディター" Click="歌詞エディターToolStripMenuItem_Click" />
                            <MenuItem x:Name="サウンドマネージャーToolStripMenuItem" Header="サウンドマネージャー" Click="サウンドマネージャーToolStripMenuItem_Click" />
                            <MenuItem x:Name="設定ファイルライターToolStripMenuItem" Header="設定ファイルライター" Click="設定ファイルライターToolStripMenuItem_Click" />
                            <MenuItem x:Name="bPMToolStripMenuItem" Header="BPM測定" Click="BPMToolStripMenuItem_Click" />
                            <MenuItem x:Name="レイヤーマネージャーToolStripMenuItem" Header="レイヤーマネージャー" Click="レイヤーマネージャーToolStripMenuItem_Click" />
                            <MenuItem x:Name="イベントマネージャーToolStripMenuItem" Header="イベントマネージャー" Click="イベントマネージャーToolStripMenuItem_Click" />
                            <MenuItem x:Name="幾何クリエーターToolStripMenuItem" Header="幾何クリエーター" Click="幾何クリエーターToolStripMenuItem_Click" />
                            <MenuItem x:Name="メモToolStripMenuItem" Header="メモ" Click="メモToolStripMenuItem_Click" />
                            <MenuItem x:Name="リソースマネージャーToolStripMenuItem" Header="リソースマネージャー" Click="リソースマネージャーToolStripMenuItem_Click" />
                            <MenuItem x:Name="スクリプトマネージャーToolStripMenuItem" Header="スクリプトマネージャー" Click="スクリプトマネージャーToolStripMenuItem_Click" />
                            <MenuItem x:Name="統計ToolStripMenuItem" Header="統計" Click="統計ToolStripMenuItem_Click" />
                            <MenuItem x:Name="ヘルプToolStripMenuItem" Header="ヘルプ" Click="ヘルプToolStripMenuItem_Click" />
                            <Separator />
                            <MenuItem x:Name="ビューを読み込むToolStripMenuItem" Header="ビューを読み込む" />
                            <MenuItem x:Name="ドックを固定ToolStripMenuItem" Header="ドックを固定" Click="ドックを固定ToolStripMenuItem_Click" />
                        </MenuItem>
                        <MenuItem x:Name="ゲームToolStripMenuItem" Header="ゲーム">
                            <MenuItem x:Name="現在の時間から開始ToolStripMenuItem" Header="現在の時間から開始" InputGestureText="Ctrl+G" Click="現在の時間から開始ToolStripMenuItem_Click" />
                            <MenuItem x:Name="最初から開始ToolStripMenuItem" Header="最初から開始" InputGestureText="Ctrl+Shift+G" Click="最初から開始ToolStripMenuItem_Click" />
                            <MenuItem x:Name="現在の時間から開始オートToolStripMenuItem" Header="現在の時間から開始(オート)" InputGestureText="Ctrl+1" Click="現在の時間から開始オートToolStripMenuItem_Click" />
                            <MenuItem x:Name="最初から開始オートToolStripMenuItem" Header="最初から開始(オート)" InputGestureText="Ctrl+Shift+1" Click="最初から開始オートToolStripMenuItem_Click" />
                            <MenuItem x:Name="メニューから開始ToolStripMenuItem" Header="メニューから開始" Click="メニューから開始ToolStripMenuItem_Click" />
                            <MenuItem x:Name="pPDプロセスを強制終了ToolStripMenuItem" Header="PPDプロセスを強制終了" IsEnabled="False" Click="PPDプロセスを強制終了ToolStripMenuItem_Click" />
                            <Separator />
                            <MenuItem x:Name="connectToolStripMenuItem" Header="Connect" Click="ConnectToolStripMenuItem_Click" />
                            <MenuItem x:Name="mODToolStripMenuItem" Header="MOD" />
                            <Separator />
                            <MenuItem x:Name="disableExpansionToolStripMenuItem" Header="Expansionを起動しない" Click="DisableExpansionToolStripMenuItem_Click" />
                        </MenuItem>
                        <MenuItem x:Name="難易度ToolStripMenuItem" Header="難易度" IsEnabled="False">
                            <MenuItem x:Name="easyToolStripMenuItem" Header="Easy" IsEnabled="False" Click="EasyToolStripMenuItem_Click" />
                            <MenuItem x:Name="normalToolStripMenuItem" Header="Normal" IsEnabled="False" Click="NormalToolStripMenuItem_Click" />
                            <MenuItem x:Name="hardToolStripMenuItem" Header="Hard" IsEnabled="False" Click="HardToolStripMenuItem_Click" />
                            <MenuItem x:Name="extremeToolStripMenuItem" Header="Extreme" IsEnabled="False" Click="ExtremeToolStripMenuItem_Click" />
                            <MenuItem x:Name="baseToolStripMenuItem" Header="Base" Click="BaseToolStripMenuItem_Click" />
                            <MenuItem x:Name="現在の難易度をコピーToolStripMenuItem" Header="現在の難易度をコピー" Click="現在の難易度をコピーToolStripMenuItem_Click" />
                        </MenuItem>
                        <MenuItem x:Name="言語ToolStripMenuItem" Header="言語" />
                        <MenuItem x:Name="その他ToolStripMenuItem" Header="その他">
                            <MenuItem x:Name="ツールバーを隠すToolStripMenuItem" Header="ツールバーを隠す" Click="ツールバーを隠すToolStripMenuItem_Click" />
                            <MenuItem x:Name="設定ToolStripMenuItem" Header="設定" Click="設定ToolStripMenuItem_Click" />
                        </MenuItem>
                    </Menu>
                    <ToolBarTray x:Name="toolBarTray" Background="Transparent" IsLocked="True">
                        <ToolBar x:Name="toolStrip1" Background="Transparent">
                            <TextBox x:Name="toolStripTextBox1" Text="100" Width="100" ToolTip="BPM" TextChanged="ToolStripTextBox1_TextChanged" />
                            <TextBox x:Name="toolStripTextBox2" Text="0" Width="100" ToolTip="BPM offset(1/BPM)" TextChanged="ToolStripTextBox2_TextChanged" />
                            <TextBox x:Name="toolStripTextBox3" Text="240" Width="100" ToolTip="タイムラインの幅" TextChanged="ToolStripTextBox3_TextChanged" />
                            <Separator />
                            <ComboBox x:Name="toolStripComboBox1" Width="180" SelectionChanged="ToolStripComboBox1_SelectedIndexChanged">
                                <ComboBoxItem Content="４分の１拍子まで表示" />
                                <ComboBoxItem Content="８分の１拍子まで表示" />
                                <ComboBoxItem Content="１６分の１拍子まで表示" />
                                <ComboBoxItem Content="３２分の１拍子まで表示" />
                                <ComboBoxItem Content="６４分の１拍子まで表示" />
                                <ComboBoxItem Content="１２分の１拍子まで表示" />
                                <ComboBoxItem Content="２４分の１拍子まで表示" />
                                <ComboBoxItem Content="４８分の１拍子まで表示" />
                            </ComboBox>
                            <ComboBox x:Name="toolStripComboBox3" Width="150" SelectionChanged="ToolStripComboBox3_SelectedIndexChanged">
                                <ComboBoxItem Content="2拍子" />
                                <ComboBoxItem Content="3拍子" />
                                <ComboBoxItem Content="4拍子" />
                                <ComboBoxItem Content="5拍子" />
                            </ComboBox>
                            <ComboBox x:Name="toolStripComboBox2" Width="75" SelectionChanged="ToolStripComboBox2_SelectedIndexChanged">
                                <ComboBoxItem Content="x 0.5" />
                                <ComboBoxItem Content="x 0.75" />
                                <ComboBoxItem Content="x 1.0" />
                                <ComboBoxItem Content="x 1.25" />
                                <ComboBoxItem Content="x 1.5" />
                                <ComboBoxItem Content="x 1.75" />
                                <ComboBoxItem Content="x 2.0" />
                            </ComboBox>
                            <Separator />
                            <ToggleButton x:Name="toolStripButton1" IsChecked="True" ToolTip="打鍵操作をBPMに固定" Style="{StaticResource ToolImageButton}">
                                <Image Source="/img/fix.png" Stretch="None" />
                            </ToggleButton>
                            <ToggleButton x:Name="toolStripButton2" IsChecked="True" ToolTip="トグルを表示" Style="{StaticResource ToolImageButton}">
                                <Image Source="/img/toggle.png" Stretch="None" />
                            </ToggleButton>
                            <ToggleButton x:Name="toolStripButton4" ToolTip="マークフォーカス" Style="{StaticResource ToolImageButton}">
                                <Image Source="/img/markfocus.png" Stretch="None" />
                            </ToggleButton>
                            <Button x:Name="toolStripButton4DropDown" Style="{StaticResource DropDownArrow}" Click="DropDownButton_Click">
                                <Path Data="M 0 0 L 6 0 L 3 3 Z" Fill="Black" VerticalAlignment="Center" />
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="詳細設定ToolStripMenuItem1" Header="詳細設定" Click="詳細設定ToolStripMenuItem1_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <ToggleButton x:Name="exToolStripSplitButton1" ToolTip="グリッド表示" Style="{StaticResource ToolImageButton}">
                                <Image Source="/img/grid.png" Stretch="None" />
                            </ToggleButton>
                            <Button x:Name="exToolStripSplitButton1DropDown" Style="{StaticResource DropDownArrow}" Click="DropDownButton_Click">
                                <Path Data="M 0 0 L 6 0 L 3 3 Z" Fill="Black" VerticalAlignment="Center" />
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="gridMenu">
                                        <MenuItem x:Name="pxToolStripMenuItem1" Header="10px" IsCheckable="True" Click="PxToolStripMenuItem1_Click" />
                                        <MenuItem x:Name="pxToolStripMenuItem2" Header="20px" IsCheckable="True" Click="PxToolStripMenuItem2_Click" />
                                        <MenuItem x:Name="pxToolStripMenuItem3" Header="50px" IsCheckable="True" Click="PxToolStripMenuItem3_Click" />
                                        <MenuItem x:Name="詳細設定ToolStripMenuItem" Header="詳細設定" IsCheckable="True" Click="詳細設定ToolStripMenuItem_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <ToggleButton x:Name="toolStripSplitButton1" Style="{StaticResource ToolImageButton}"
                                          Checked="ToolStripSplitButton1_CheckStateChanged" Unchecked="ToolStripSplitButton1_CheckStateChanged">
                                <Image Source="/img/timeline.png" Stretch="None" />
                            </ToggleButton>
                            <Button x:Name="toolStripSplitButton1DropDown" Style="{StaticResource DropDownArrow}" Click="DropDownButton_Click">
                                <Path Data="M 0 0 L 6 0 L 3 3 Z" Fill="Black" VerticalAlignment="Center" />
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="詳細設定ToolStripMenuItem2" Header="詳細設定" Click="詳細設定ToolStripMenuItem2_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <ToggleButton x:Name="toolStripButton3" IsChecked="True" ToolTip="ホールドの範囲を表示" Style="{StaticResource ToolImageButton}">
                                <Image Source="/img/showholdextent.png" Stretch="None" />
                            </ToggleButton>
                        </ToolBar>
                    </ToolBarTray>
                </StackPanel>
            </Grid>
            <Grid DockPanel.Dock="Bottom">
                <Rectangle x:Name="bottomOverlay" />
                <StatusBar x:Name="statusStrip1" Background="Transparent">
                    <StatusBarItem Width="79">
                        <TextBlock x:Name="toolStripStatusLabel1" Text="0:00:00:000" />
                    </StatusBarItem>
                    <StatusBarItem Width="292">
                        <TextBlock x:Name="toolStripStatusLabel2" Text="エリア選択オフ" />
                    </StatusBarItem>
                    <StatusBarItem>
                        <TextBlock x:Name="toolStripStatusLabel3" />
                    </StatusBarItem>
                </StatusBar>
            </Grid>
            <ad:DockingManager x:Name="dockPanel1" Background="Transparent" />
        </DockPanel>
    </Grid>
</Window>
