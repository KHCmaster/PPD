<Window x:Class="PPDEditor.Forms.ImportEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PPDEditor.ViewModels.Dialogs"
        xmlns:conv="clr-namespace:PPDEditor.Converters"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ImportEventViewModel}"
        Title="{Binding Texts[Import]}" Width="596" Height="433" ShowInTaskbar="False">
    <Window.Resources>
        <conv:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserSortColumns" Value="False" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button Content="OK" Width="75" Height="23" Command="{Binding OkCommand}" />
            <Button Content="Cancel" Width="75" Height="23" Margin="40,0,0,0" IsCancel="True" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- 左が今のイベント、右が読み込んだイベント（読み込みだけ）。ダブルクリックで中身を見る -->
            <DataGrid x:Name="currentGrid" ItemsSource="{Binding CurrentEvents}" SelectedItem="{Binding SelectedCurrentEvent}">
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ShowEventCommand}" CommandParameter="{Binding SelectedItem, ElementName=currentGrid}" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding Data.TimeHeader, Source={StaticResource Proxy}}" Binding="{Binding Key}" Width="Auto" />
                    <DataGridTextColumn Header="{Binding Data.Texts[Detail], Source={StaticResource Proxy}}" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,120,0,0">
                <Button Content="{Binding ImportText}" MinWidth="75" Height="23" Command="{Binding ImportCommand}" />
                <Button Content="{Binding Texts[Delete]}" MinWidth="75" Height="23" Margin="0,6,0,0" Command="{Binding DeleteCommand}" />
            </StackPanel>
            <DataGrid x:Name="readOnlyGrid" Grid.Column="2" ItemsSource="{Binding ReadOnlyEvents}" SelectedItem="{Binding SelectedReadOnlyEvent}">
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ShowEventCommand}" CommandParameter="{Binding SelectedItem, ElementName=readOnlyGrid}" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding Data.TimeHeader, Source={StaticResource Proxy}}" Binding="{Binding Key}" Width="Auto" />
                    <DataGridTextColumn Header="{Binding Data.Texts[Detail], Source={StaticResource Proxy}}" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
