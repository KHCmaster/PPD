<Window x:Class="PPDEditor.Forms.SwapLineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ライン入れ替え" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="13,13,13,8" MinWidth="164">
        <TextBlock x:Name="label1" Text="入れ替えるラインを選択してください" />
        <TextBlock x:Name="label2" Text="ひとつめ" Margin="0,10,0,0" />
        <ComboBox x:Name="comboBox1" Width="121" HorizontalAlignment="Left" Margin="2,4,0,0" />
        <TextBlock x:Name="label3" Text="ふたつめ" Margin="0,8,0,0" />
        <ComboBox x:Name="comboBox2" Width="121" HorizontalAlignment="Left" Margin="2,4,0,0" />
        <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
            <Button x:Name="button1" Content="OK" Width="75" Height="23" IsDefault="True" Click="Button1_Click" />
            <Button x:Name="button2" Content="Cancel" Width="75" Height="23" Margin="7,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
