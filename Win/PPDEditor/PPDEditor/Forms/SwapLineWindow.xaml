<Window x:Class="PPDEditor.Forms.SwapLineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PPDEditor.ViewModels.Dialogs"
        xmlns:conv="clr-namespace:PPDEditor.Converters"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:SwapLineViewModel}"
        Title="{Binding Texts[SwapLine]}" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="13,13,13,8" MinWidth="164">
        <TextBlock Text="{Binding Texts[SwapLineLabel1]}" />
        <TextBlock Text="{Binding Texts[SwapLineLabel2]}" Margin="0,10,0,0" />
        <ComboBox ItemsSource="{Binding Lines}" SelectedIndex="{Binding First}" Width="121" HorizontalAlignment="Left" Margin="2,4,0,0" />
        <TextBlock Text="{Binding Texts[SwapLineLabel3]}" Margin="0,8,0,0" />
        <ComboBox ItemsSource="{Binding Lines}" SelectedIndex="{Binding Second}" Width="121" HorizontalAlignment="Left" Margin="2,4,0,0" />
        <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
            <Button Content="OK" Width="75" Height="23" IsDefault="True" Command="{Binding OkCommand}" />
            <Button Content="Cancel" Width="75" Height="23" Margin="7,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
