<Window x:Class="PPDEditor.Forms.MovieCutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="切り取り" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=textBox1}">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock" x:Key="SideLabel">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="9">
        <TextBlock x:Name="label5" Text="それぞれピクセルで指定してください" />
        <Grid HorizontalAlignment="Center" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="35" />
                <RowDefinition Height="35" />
                <RowDefinition Height="35" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="label1" Text="左" Style="{StaticResource SideLabel}" />
            <TextBox x:Name="textBox1" Grid.Column="1" KeyDown="TextBox_KeyDown" />
            <TextBlock x:Name="label2" Grid.Row="1" Text="右" Style="{StaticResource SideLabel}" />
            <TextBox x:Name="textBox2" Grid.Row="1" Grid.Column="1" KeyDown="TextBox_KeyDown" />
            <TextBlock x:Name="label3" Grid.Row="2" Text="上" Style="{StaticResource SideLabel}" />
            <TextBox x:Name="textBox3" Grid.Row="2" Grid.Column="1" KeyDown="TextBox_KeyDown" />
            <TextBlock x:Name="label4" Grid.Row="3" Text="下" Style="{StaticResource SideLabel}" />
            <TextBox x:Name="textBox4" Grid.Row="3" Grid.Column="1" KeyDown="TextBox_KeyDown" />
        </Grid>
        <CheckBox x:Name="applyIniCheckBox" Content="設定ファイルライターに反映させる" HorizontalAlignment="Center" Margin="0,4,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
            <Button x:Name="button1" Content="OK" Width="75" Height="23" Click="Button1_Click" />
            <Button x:Name="button2" Content="Cancel" Width="75" Height="23" Margin="6,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
