<Window x:Class="PPDEditor.Forms.AuthorNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="12,9,12,12" Width="330">
        <TextBlock x:Name="label1" Text="作者名として表示する名前を入力してください" />
        <TextBox x:Name="textBox1" Width="161" Height="20" HorizontalAlignment="Right" Margin="0,4,0,0" VerticalContentAlignment="Center" />
        <Button x:Name="button1" Content="OK" Width="75" Height="23" HorizontalAlignment="Right" Margin="0,6,0,0" IsDefault="True" Click="Button1_Click" />
    </StackPanel>
</Window>
