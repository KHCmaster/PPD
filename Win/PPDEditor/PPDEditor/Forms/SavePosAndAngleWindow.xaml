<Window x:Class="PPDEditor.Forms.SavePosAndAngleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="確認" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=textBox1}">
    <StackPanel Margin="10" MinWidth="160">
        <TextBlock x:Name="label2" Text="label2" />
        <RadioButton x:Name="radioButton1" Content="位置(x,y)を保存" Margin="20,10,0,0" IsChecked="True" />
        <RadioButton x:Name="radioButton2" Content="位置(x,y)と角度を保存" Margin="20,12,0,0" />
        <TextBlock x:Name="label1" Text="名称を決めてください" Margin="3,16,0,0" />
        <TextBox x:Name="textBox1" Width="155" Height="20" HorizontalAlignment="Left" Margin="3,4,0,0" VerticalContentAlignment="Center" />
        <StackPanel Orientation="Horizontal" Margin="2,16,0,0">
            <!-- テキストボックスで Enter を押すと OK になる（以前と同じ） -->
            <Button x:Name="button1" Content="OK" Width="75" Height="23" IsDefault="True" Click="Button1_Click" />
            <Button x:Name="button2" Content="Cancel" Width="75" Height="23" Margin="6,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
