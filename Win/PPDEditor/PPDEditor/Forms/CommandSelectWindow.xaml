<Window x:Class="PPDEditor.Forms.CommandSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="コマンドを選択" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TreeView x:Name="treeView1" Width="260" Height="209" SelectedItemChanged="TreeView1_SelectedItemChanged" MouseDoubleClick="TreeView1_MouseDoubleClick">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,3,0" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
            <Button x:Name="okButton" Content="OK" Width="75" Height="23" IsDefault="True" IsEnabled="False" Click="OkButton_Click" />
            <Button x:Name="cancelButton" Content="Cancel" Width="75" Height="23" Margin="19,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
