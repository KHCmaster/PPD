<Window x:Class="PPDEditor.Forms.GridSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="100" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="24" />
                <RowDefinition Height="24" />
                <RowDefinition Height="24" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="widthLabel" Text="幅" VerticalAlignment="Center" />
            <TextBox x:Name="widthBox" Grid.Column="1" Height="20" VerticalContentAlignment="Center" />
            <TextBlock x:Name="heightLabel" Grid.Row="1" Text="高さ" VerticalAlignment="Center" />
            <TextBox x:Name="heightBox" Grid.Row="1" Grid.Column="1" Height="20" VerticalContentAlignment="Center" />
            <TextBlock x:Name="offsetXLabel" Grid.Row="2" Text="Xオフセット" VerticalAlignment="Center" />
            <TextBox x:Name="offsetXBox" Grid.Row="2" Grid.Column="1" Height="20" VerticalContentAlignment="Center" />
            <TextBlock x:Name="offsetYLabel" Grid.Row="3" Text="Yオフセット" VerticalAlignment="Center" />
            <TextBox x:Name="offsetYBox" Grid.Row="3" Grid.Column="1" Height="20" VerticalContentAlignment="Center" />
            <TextBlock x:Name="colorLabel" Grid.Row="4" Text="色" VerticalAlignment="Center" />
            <DockPanel Grid.Row="4" Grid.Column="1" VerticalAlignment="Center">
                <Button x:Name="colorButton" DockPanel.Dock="Right" Content="..." Width="24" Height="20" Margin="4,0,0,0" Click="ColorButton_Click" />
                <Border x:Name="colorPreview" Height="18" BorderBrush="Gray" BorderThickness="1">
                    <TextBlock x:Name="colorText" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </DockPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button x:Name="button1" Content="OK" Width="75" Height="23" IsDefault="True" Click="Button1_Click" />
            <Button x:Name="button2" Content="Cancel" Width="75" Height="23" Margin="43,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
