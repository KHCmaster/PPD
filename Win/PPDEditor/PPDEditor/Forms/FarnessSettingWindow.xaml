<Window x:Class="PPDEditor.Forms.FarnessSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <StackPanel Orientation="Horizontal">
            <Slider x:Name="trackBar1" Width="159" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" />
            <TextBlock x:Name="label1" Width="30" Margin="6,0,0,0" VerticalAlignment="Center"
                       Text="{Binding Value, ElementName=trackBar1, StringFormat={}{0:0}}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="button1" Content="OK" Width="75" Height="23" IsDefault="True" Click="Button1_Click" />
            <Button x:Name="button2" Content="Cancel" Width="75" Height="23" Margin="6,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
