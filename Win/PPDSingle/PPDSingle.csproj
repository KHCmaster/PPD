<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>PPDSingle</RootNamespace>
    <AssemblyName>PPDSingle</AssemblyName>
    <Platforms>x64</Platforms>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- skins フォルダーには SQLite のネイティブ DLL を置かない（PPD 本体のフォルダーのものを使う） -->
    <CopySQLiteInteropFiles>false</CopySQLiteInteropFiles>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>..\PPD\PPD\bin\x64\Debug\skins\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>false</Prefer32Bit>
    <CodeAnalysisRuleSet>..\PPDCommon.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <OutputPath>..\release\x64\PPD\skins\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpZipLib" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PPDMath\PPDMath.csproj" />
    <ProjectReference Include="..\Effect2D\Effect2D.csproj" />
    <ProjectReference Include="..\PPDConfiguration\PPDConfiguration.csproj" />
    <ProjectReference Include="..\PPDCoreModel\PPDCoreModel.csproj" />
    <ProjectReference Include="..\PPDCore\PPDCore.csproj" />
    <ProjectReference Include="..\PPDFrameworkCore\PPDFrameworkCore.csproj" />
    <ProjectReference Include="..\PPDFramework\PPDFramework.csproj" />
    <ProjectReference Include="..\PPDModSettingUI\PPDModSettingUI.csproj" />
    <ProjectReference Include="..\PPDMovie\PPDMovie.csproj" />
    <ProjectReference Include="..\PPDShareComponent\PPDShareComponent.csproj" />
  </ItemGroup>
</Project>
