<Window x:Class="FlowScriptControlTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FlowScriptControl.Controls;assembly=FlowScriptControl"
        Title="FlowScriptControlTest" Width="1184" Height="640"
        Loaded="Window_Loaded" Closing="Window_Closing" KeyDown="Window_KeyDown">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="ファイル">
                <MenuItem Header="新規作成" Click="NewMenuItem_Click" />
                <MenuItem Header="開く" Click="OpenMenuItem_Click" />
                <MenuItem Header="保存" Click="SaveMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="編集">
                <MenuItem Header="元に戻す" InputGestureText="Ctrl+Z" Click="UndoMenuItem_Click" />
                <MenuItem Header="やり直す" InputGestureText="Ctrl+Y" Click="RedoMenuItem_Click" />
                <MenuItem Header="コピー" InputGestureText="Ctrl+C" Click="CopyMenuItem_Click" />
                <MenuItem Header="貼り付け" InputGestureText="Ctrl+V" Click="PasteMenuItem_Click" />
                <MenuItem Header="リンクも貼り付け" InputGestureText="Ctrl+Shift+V" Click="PasteWithLinksMenuItem_Click" />
                <MenuItem Header="削除" InputGestureText="Del" Click="DeleteMenuItem_Click" />
                <MenuItem Header="位置を自動調整" Click="AdjustPositionMenuItem_Click" />
                <MenuItem Header="全て展開" Click="ExpandAllMenuItem_Click" />
                <MenuItem Header="全て縮小" Click="CollapseAllMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="コンソール">
                <MenuItem Header="クリア" Click="ClearConsoleMenuItem_Click" />
                <MenuItem Header="標準入力" Click="StdinMenuItem_Click" />
            </MenuItem>
        </Menu>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button x:Name="executeButton" Click="ExecuteButton_Click" ToolTip="実行">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="img/playonce.png" Width="16" Height="16" Margin="0,0,3,0" />
                        <TextBlock Text="実行" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </ToolBar>
            <ToolBar x:Name="debugToolBar" Visibility="Collapsed">
                <Button x:Name="continueButton" Click="ContinueButton_Click" ToolTip="続行">
                    <Image Source="img/playonce.png" Width="16" Height="16" />
                </Button>
                <Button x:Name="stopButton" Click="StopButton_Click" ToolTip="停止">
                    <Image Source="img/stop.png" Width="16" Height="16" />
                </Button>
                <Button x:Name="stepInButton" Click="StepInButton_Click" ToolTip="ステップイン">
                    <Image Source="img/stepin.png" Width="16" Height="16" />
                </Button>
            </ToolBar>
        </ToolBarTray>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="738*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="426*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="431*" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="96*" />
                </Grid.RowDefinitions>
                <TabControl x:Name="drawTabControl" SelectionChanged="DrawTabControl_SelectionChanged" />
                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <TextBox x:Name="consoleTextBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="MS Gothic" />
            </Grid>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="248*" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="279*" />
                </Grid.RowDefinitions>
                <TabControl x:Name="toolTabControl">
                    <TabItem Header="ノードリスト">
                        <controls:FlowTreeView x:Name="flowTreeView" />
                    </TabItem>
                    <TabItem x:Name="searchTabItem" Header="検索">
                        <controls:FlowSearchPanel x:Name="flowSearchPanel" />
                    </TabItem>
                    <TabItem Header="デバッグ">
                        <controls:FlowExecutingPropertyPanel x:Name="flowExecutingPropertyPanel" />
                    </TabItem>
                </TabControl>
                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <controls:FlowPropertyPanel x:Name="flowPropertyPanel" Grid.Row="2" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
