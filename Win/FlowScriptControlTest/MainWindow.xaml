<Window x:Class="FlowScriptControlTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:FlowScriptControl.Controls;assembly=FlowScriptControl"
        xmlns:vm="clr-namespace:FlowScriptControlTest.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="FlowScriptControlTest" Width="1184" Height="640" Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <!-- 編集のショートカットは、編集の領域にフォーカスがあるときだけ効く（ViewModel で確かめる） -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoCommand}" CommandParameter="Shortcut" />
        <KeyBinding Modifiers="Ctrl" Key="Y" Command="{Binding RedoCommand}" CommandParameter="Shortcut" />
        <KeyBinding Modifiers="Ctrl" Key="C" Command="{Binding CopyCommand}" CommandParameter="Shortcut" />
        <KeyBinding Modifiers="Ctrl" Key="V" Command="{Binding PasteCommand}" CommandParameter="Shortcut" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="V" Command="{Binding PasteWithLinksCommand}" CommandParameter="Shortcut" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" CommandParameter="Shortcut" />
    </Window.InputBindings>
    <!-- AutomationId は UI の自動テスト（UITests）で使う -->
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem AutomationProperties.AutomationId="FileMenu" Header="ファイル">
                <MenuItem AutomationProperties.AutomationId="NewMenuItem" Header="新規作成" Command="{Binding NewDocumentCommand}" />
                <MenuItem AutomationProperties.AutomationId="OpenMenuItem" Header="開く" Command="{Binding OpenCommand}" />
                <MenuItem AutomationProperties.AutomationId="SaveMenuItem" Header="保存" Command="{Binding SaveCommand}" />
            </MenuItem>
            <MenuItem AutomationProperties.AutomationId="EditMenu" Header="編集">
                <MenuItem AutomationProperties.AutomationId="UndoMenuItem" Header="元に戻す" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                <MenuItem AutomationProperties.AutomationId="RedoMenuItem" Header="やり直す" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
                <MenuItem Header="コピー" InputGestureText="Ctrl+C" Command="{Binding CopyCommand}" />
                <MenuItem Header="貼り付け" InputGestureText="Ctrl+V" Command="{Binding PasteCommand}" />
                <MenuItem Header="リンクも貼り付け" InputGestureText="Ctrl+Shift+V" Command="{Binding PasteWithLinksCommand}" />
                <MenuItem Header="削除" InputGestureText="Del" Command="{Binding DeleteCommand}" />
                <MenuItem AutomationProperties.AutomationId="AdjustPositionMenuItem" Header="位置を自動調整" Command="{Binding AdjustPositionCommand}" />
                <MenuItem AutomationProperties.AutomationId="ExpandAllMenuItem" Header="全て展開" Command="{Binding ExpandAllCommand}" />
                <MenuItem AutomationProperties.AutomationId="CollapseAllMenuItem" Header="全て縮小" Command="{Binding CollapseAllCommand}" />
            </MenuItem>
            <MenuItem AutomationProperties.AutomationId="ConsoleMenu" Header="コンソール">
                <MenuItem AutomationProperties.AutomationId="ClearConsoleMenuItem" Header="クリア" Command="{Binding ClearConsoleCommand}" />
                <MenuItem AutomationProperties.AutomationId="StdinMenuItem" Header="標準入力" Command="{Binding EditStdinCommand}" />
            </MenuItem>
        </Menu>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button AutomationProperties.AutomationId="ExecuteButton" Command="{Binding ExecuteCommand}" ToolTip="実行">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="img/playonce.png" Width="16" Height="16" Margin="0,0,3,0" />
                        <TextBlock Text="実行" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </ToolBar>
            <ToolBar Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVisibility}}">
                <Button Command="{Binding ContinueCommand}" ToolTip="続行">
                    <Image Source="img/playonce.png" Width="16" Height="16" />
                </Button>
                <Button AutomationProperties.AutomationId="StopButton" Command="{Binding StopCommand}" ToolTip="停止">
                    <Image Source="img/stop.png" Width="16" Height="16" />
                </Button>
                <Button Command="{Binding StepInCommand}" ToolTip="ステップイン">
                    <Image Source="img/stepin.png" Width="16" Height="16" />
                </Button>
            </ToolBar>
        </ToolBarTray>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="738*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="426*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="431*" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="96*" />
                </Grid.RowDefinitions>
                <TabControl AutomationProperties.AutomationId="DocumentTabs" ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Header}" />
                        </Style>
                    </TabControl.ItemContainerStyle>
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 見出しの右クリックで閉じる -->
                            <TextBlock Text="{Binding Header}">
                                <TextBlock.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem AutomationProperties.AutomationId="CloseTabMenuItem" Header="タブを閉じる"
                                                  Command="{Binding PlacementTarget.Tag.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </TextBlock.ContextMenu>
                                <TextBlock.Tag>
                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=TabControl}" />
                                </TextBlock.Tag>
                            </TextBlock>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding Editor}" Focusable="False" />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <TextBox AutomationProperties.AutomationId="ConsoleTextBox" Grid.Row="2" Text="{Binding ConsoleText, Mode=OneWay}" TextChanged="ConsoleTextBox_TextChanged" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="MS Gothic" />
            </Grid>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="248*" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="279*" />
                </Grid.RowDefinitions>
                <TabControl x:Name="toolTabControl">
                    <TabItem Header="ノードリスト">
                        <controls:FlowTreeView x:Name="flowTreeView" />
                    </TabItem>
                    <TabItem x:Name="searchTabItem" Header="検索">
                        <controls:FlowSearchPanel x:Name="flowSearchPanel" />
                    </TabItem>
                    <TabItem Header="デバッグ">
                        <controls:FlowExecutingPropertyPanel x:Name="flowExecutingPropertyPanel" />
                    </TabItem>
                </TabControl>
                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <controls:FlowPropertyPanel x:Name="flowPropertyPanel" Grid.Row="2" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
