<Window x:Class="FlowScriptControlTest.StdinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="標準入力" Width="520" Height="330" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- DataContext はウィンドウ自身（文字列を 1 つ編集するだけなので、ViewModel を分けない） -->
    <DockPanel Margin="12">
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Width="75" Margin="0,8,0,0" Content="OK" IsDefault="True" Click="OkButton_Click" />
        <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
