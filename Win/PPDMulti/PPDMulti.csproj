<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>PPDMulti</RootNamespace>
    <AssemblyName>PPDMulti</AssemblyName>
    <Platforms>x64</Platforms>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>..\PPD\PPD\bin\x64\Debug\skins\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>false</Prefer32Bit>
    <CodeAnalysisRuleSet>..\PPDCommon.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <OutputPath>..\release\x64\PPD\skins\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommonServiceLocator" Version="1.3" />
    <PackageReference Include="MessagePack" Version="1.9.11" />
    <PackageReference Include="MvvmLight" Version="4.2.32.7" />
    <PackageReference Include="MvvmLightLibs" Version="4.4.32.7" />
    <PackageReference Include="SharpDX" Version="3.1.1" />
    <PackageReference Include="SharpDX.Mathematics" Version="3.1.1" />
    <PackageReference Include="System.Reflection.Emit" Version="4.3.0" />
    <PackageReference Include="System.Reflection.Emit.Lightweight" Version="4.3.0" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="4.5.2" />
    <PackageReference Include="System.Runtime.Serialization.Primitives" Version="4.3.0" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.3" />
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Web" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Effect2D\Effect2D.csproj" />
    <ProjectReference Include="..\PPDConfiguration\PPDConfiguration.csproj" />
    <ProjectReference Include="..\PPDCoreModel\PPDCoreModel.csproj" />
    <ProjectReference Include="..\PPDCore\PPDCore.csproj" />
    <ProjectReference Include="..\PPDExpansionCore\PPDExpansionCore.csproj" />
    <ProjectReference Include="..\PPDFrameworkCore\PPDFrameworkCore.csproj" />
    <ProjectReference Include="..\PPDFramework\PPDFramework.csproj" />
    <ProjectReference Include="..\PPDModSettingUI\PPDModSettingUI.csproj" />
    <ProjectReference Include="..\PPDMultiCommon\PPDMultiCommon.csproj" />
    <ProjectReference Include="..\PPDMultiServer\PPDMultiServer.csproj" />
    <ProjectReference Include="..\PPDPack\PPDPack.csproj" />
    <ProjectReference Include="..\PPDShareComponent\PPDShareComponent.csproj" />
  </ItemGroup>
</Project>
