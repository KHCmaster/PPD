<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>PPD</RootNamespace>
    <AssemblyName>PPD</AssemblyName>
    <ApplicationIcon>ppd.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>TRACE;DEBUG;x64</DefineConstants>
    <DebugType>full</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>false</Prefer32Bit>
    <CodeAnalysisRuleSet>..\..\PPDCommon.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <OutputPath>..\..\release\x64\PPD\</OutputPath>
    <DefineConstants>TRACE;x64</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <!-- skins の PPDModSettingUI が使う。PPD.exe のフォルダーに新しい版の依存 DLL を置き、バインディングリダイレクトを自動生成させるために PPD 本体でも参照する -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="SharpDX" />
    <PackageReference Include="SharpDX.Desktop" />
    <PackageReference Include="SharpDX.DirectInput" />
    <PackageReference Include="SharpDX.Mathematics" />
    <PackageReference Include="System.Data.SQLite.Core" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Deployment" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\DirectShow\DirectShow.csproj" />
    <ProjectReference Include="..\..\Effect2D\Effect2D.csproj" />
    <ProjectReference Include="..\..\ErrorHandler\ErrorHandle.csproj" />
    <ProjectReference Include="..\..\PPDSound\PPDSound.csproj" />
    <ProjectReference Include="..\..\PPDConfiguration\PPDConfiguration.csproj" />
    <ProjectReference Include="..\..\PPDCore\PPDCore.csproj" />
    <ProjectReference Include="..\..\PPDFrameworkCore\PPDFrameworkCore.csproj" />
    <ProjectReference Include="..\..\PPDFramework\PPDFramework.csproj" />
    <ProjectReference Include="..\..\PPDInput\PPDInput.csproj" />
    <ProjectReference Include="..\..\PPDMovie\PPDMovie.csproj" />
    <ProjectReference Include="..\..\PPDPack\PPDPack.csproj" />
    <ProjectReference Include="..\..\PPDShareComponent\PPDShareComponent.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Forms\LoginForm.resx">
      <DependentUpon>LoginForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <None Update="Lang\lang_PPDMulti_en.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_PPDMulti_es.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_PPDMulti_jp.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_PPDMulti_kr.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_PPDMulti_zh1.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_PPDMulti_zh2.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_PPDSingle_en.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_PPDSingle_es.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_PPDSingle_jp.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_PPDSingle_kr.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_PPDSingle_zh1.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_PPDSingle_zh2.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_PPD_en.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_PPD_es.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_PPD_jp.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_PPD_kr.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_PPD_zh1.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
