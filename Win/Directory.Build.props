<Project>
  <!-- 全プロジェクト共通の設定（SDK 形式の csproj に変換したときに、従来の出力を変えないためのもの） -->
  <PropertyGroup>
    <!-- 出力先は従来どおり bin\<Platform>\<Configuration>\（net48 などのフォルダーを付けない） -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- バージョンなどは各プロジェクトの Properties\AssemblyInfo.cs で指定している -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- 埋め込みリソースの名前を従来と同じ規則（DependentUpon の指定があるときだけ型名を使う）で付ける -->
    <EmbeddedResourceUseDependentUponConvention>false</EmbeddedResourceUseDependentUponConvention>
    <!-- WFO1000: WinForms デザイナー向けの分析（コントロールの公開プロパティに DesignerSerializationVisibility を付ける）。実行時の動作には影響しないので抑止する -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <!-- NuGet パッケージの言語ごとのリソース（AvalonDock.resources.dll など）は出力しない（言語ごとのフォルダーができないように）。
         表示の言語は Lang の ini で切り替えるので、パッケージの文字は本体に入っている英語のままにする -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <!-- カルチャーのデータ（日付や数値の書式、文字列の比較など）を .NET Framework と同じ Windows の NLS にする。
         .NET 5 以降は既定で ICU になり、スクリプト（Mod）の表示や並び順が変わる可能性があるため -->
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="true" />
  </ItemGroup>
</Project>
