<Window x:Class="Effect2DEditor.ChangeBackGroundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="カンバス背景変更" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12" Width="270">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="22" />
            <RowDefinition Height="22" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <RadioButton x:Name="radioButton1" Content="デフォルト" VerticalAlignment="Center" />
        <RadioButton x:Name="radioButton2" Grid.Row="1" Content="色選択" VerticalAlignment="Center" />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
            <Border x:Name="colorPreview" Width="18" Height="16" BorderBrush="Gray" BorderThickness="1" Margin="0,0,4,0" />
            <Button x:Name="button1" Content="..." Width="24" Height="18" Click="Button1_Click" />
        </StackPanel>
        <RadioButton x:Name="radioButton3" Grid.Row="2" Content="画像読み込み" VerticalAlignment="Center" />
        <Button x:Name="button2" Grid.Row="2" Grid.Column="1" Content="..." Width="24" Height="18" HorizontalAlignment="Right" Click="Button2_Click" />
        <TextBox x:Name="textBox1" Grid.Row="3" Grid.ColumnSpan="2" Height="20" VerticalContentAlignment="Center" />
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button x:Name="button3" Content="OK" Width="75" Height="23" IsDefault="True" Click="Button3_Click" />
            <Button x:Name="button4" Content="Cancel" Width="75" Height="23" Margin="6,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
