<Window x:Class="Effect2DEditor.ChangeBackGroundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Effect2DEditor"
        xmlns:vm="clr-namespace:Effect2DEditor.ViewModels.Dialogs"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ChangeBackGroundViewModel}"
        Title="{Binding Texts[CBGText]}" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:EnumEqualsConverter x:Key="EnumEquals" />
        <local:DrawingColorToBrushConverter x:Key="ColorToBrush" />
    </Window.Resources>
    <Grid Margin="12" Width="270">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="22" />
            <RowDefinition Height="22" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <RadioButton AutomationProperties.AutomationId="BackDefaultRadio" Content="{Binding Texts[CBGRadioButton1]}" VerticalAlignment="Center"
                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Default}" />
        <RadioButton AutomationProperties.AutomationId="BackColorRadio" Grid.Row="1" Content="{Binding Texts[CBGRadioButton2]}" VerticalAlignment="Center"
                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Color}" />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
            <Border Width="18" Height="16" BorderBrush="Gray" BorderThickness="1" Margin="0,0,4,0"
                    Background="{Binding Color, Converter={StaticResource ColorToBrush}}" />
            <Button AutomationProperties.AutomationId="PickColorButton" Content="..." Width="24" Height="18" Command="{Binding PickColorCommand}" />
        </StackPanel>
        <RadioButton AutomationProperties.AutomationId="BackImageRadio" Grid.Row="2" Content="{Binding Texts[CBGRadioButton3]}" VerticalAlignment="Center"
                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Image}" />
        <Button AutomationProperties.AutomationId="PickImageButton" Grid.Row="2" Grid.Column="1" Content="..." Width="24" Height="18" HorizontalAlignment="Right" Command="{Binding PickImageCommand}" />
        <TextBox AutomationProperties.AutomationId="BackFileNameBox" Grid.Row="3" Grid.ColumnSpan="2" Height="20" VerticalContentAlignment="Center" Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" />
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button AutomationProperties.AutomationId="BackOkButton" Content="OK" Width="75" Height="23" IsDefault="True" Command="{Binding OkCommand}" />
            <Button Content="Cancel" Width="75" Height="23" Margin="6,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
