<Window x:Class="Effect2DEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:dock="clr-namespace:Effect2DEditor.DockForm"
        xmlns:vm="clr-namespace:Effect2DEditor.ViewModels"
        xmlns:local="clr-namespace:Effect2DEditor"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="Effect2DEditor" Width="1021" Height="690" Icon="e2dmid.ico"
        AllowDrop="True" DragEnter="Window_DragEnter" DragOver="Window_DragEnter" Drop="Window_Drop"
        Closing="Window_Closing" Closed="Window_Closed">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewEffectCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding OverwriteCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <local:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <!-- 最近使ったファイルと言語の項目 -->
        <Style x:Key="RecentFileItem" TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding Header}" />
            <Setter Property="Command" Value="{Binding Data.OpenRecentFileCommand, Source={StaticResource Proxy}}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
        </Style>
        <Style x:Key="LanguageItem" TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding Header}" />
            <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
            <Setter Property="Command" Value="{Binding Data.SelectLanguageCommand, Source={StaticResource Proxy}}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
        </Style>
    </Window.Resources>
    <!-- AutomationId は UI の自動テスト（UITests）で使う -->
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem AutomationProperties.AutomationId="FileMenu" Header="{Binding Texts[File]}">
                <MenuItem AutomationProperties.AutomationId="NewMenuItem" Header="{Binding Texts[CreateNew]}" InputGestureText="Ctrl+N" Command="{Binding NewEffectCommand}" />
                <MenuItem AutomationProperties.AutomationId="OpenMenuItem" Header="{Binding Texts[Open]}" InputGestureText="Ctrl+O" Command="{Binding OpenCommand}" />
                <MenuItem AutomationProperties.AutomationId="SaveAsMenuItem" Header="{Binding Texts[Save]}" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
                <MenuItem AutomationProperties.AutomationId="OverwriteMenuItem" Header="{Binding Texts[OverWrite]}" InputGestureText="Ctrl+S" Command="{Binding OverwriteCommand}" />
                <MenuItem AutomationProperties.AutomationId="RecentFilesMenu" Header="{Binding Texts[RecentUsedFile]}" ItemsSource="{Binding RecentFiles}" ItemContainerStyle="{StaticResource RecentFileItem}" />
                <MenuItem AutomationProperties.AutomationId="ExitMenuItem" Header="{Binding Texts[Exit]}" InputGestureText="Alt+F4" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem AutomationProperties.AutomationId="EditMenu" Header="{Binding Texts[Edit]}">
                <MenuItem AutomationProperties.AutomationId="UndoMenuItem" Header="{Binding Texts[Undo]}" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                <MenuItem AutomationProperties.AutomationId="RedoMenuItem" Header="{Binding Texts[Redo]}" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
                <MenuItem AutomationProperties.AutomationId="AnimationMenuItem" Header="{Binding Texts[Animation]}" Command="{Binding CreateAnimationCommand}" />
                <MenuItem AutomationProperties.AutomationId="CanvasSizeMenuItem" Header="{Binding Texts[CanvasSize]}" Command="{Binding ChangeCanvasSizeCommand}" />
                <MenuItem AutomationProperties.AutomationId="BackGroundMenuItem" Header="{Binding Texts[CanvasBackGround]}" Command="{Binding ChangeBackGroundCommand}" />
            </MenuItem>
            <MenuItem AutomationProperties.AutomationId="ShowMenu" Header="{Binding Texts[Show]}">
                <MenuItem AutomationProperties.AutomationId="ShowCanvasMenuItem" Header="{Binding Texts[CanvasWindow]}" Command="{Binding ToggleDockCommand}" CommandParameter="{x:Static vm:DockKind.Canvas}" />
                <MenuItem AutomationProperties.AutomationId="ShowPropertyMenuItem" Header="{Binding Texts[PropertyWindow]}" Command="{Binding ToggleDockCommand}" CommandParameter="{x:Static vm:DockKind.Property}" />
                <MenuItem AutomationProperties.AutomationId="ShowHistoryMenuItem" Header="{Binding Texts[HistoryWindow]}" Command="{Binding ToggleDockCommand}" CommandParameter="{x:Static vm:DockKind.History}" />
                <MenuItem AutomationProperties.AutomationId="ShowTimeLineMenuItem" Header="{Binding Texts[TimeLineWindow]}" Command="{Binding ToggleDockCommand}" CommandParameter="{x:Static vm:DockKind.TimeLine}" />
            </MenuItem>
            <MenuItem AutomationProperties.AutomationId="LanguageMenu" Header="{Binding Texts[Language]}" ItemsSource="{Binding Languages}" ItemContainerStyle="{StaticResource LanguageItem}" />
        </Menu>
        <ad:DockingManager x:Name="dockingManager">
            <ad:LayoutRoot>
                <ad:LayoutPanel Orientation="Horizontal">
                    <ad:LayoutPanel Orientation="Vertical">
                        <ad:LayoutDocumentPaneGroup>
                            <ad:LayoutDocumentPane>
                                <ad:LayoutAnchorable x:Name="canvasAnchorable" ContentId="Effect2DEditor.DockForm.CanvasDock" Title="キャンバスウィンドウ" CanClose="False">
                                    <dock:CanvasDock x:Name="canvasDock" />
                                </ad:LayoutAnchorable>
                            </ad:LayoutDocumentPane>
                        </ad:LayoutDocumentPaneGroup>
                        <ad:LayoutAnchorablePane DockHeight="220">
                            <ad:LayoutAnchorable x:Name="timeLineAnchorable" ContentId="Effect2DEditor.DockForm.TimeLineDock" Title="タイムラインウィンドウ" CanClose="False">
                                <dock:TimeLineDock x:Name="timeLineDock" />
                            </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>
                    </ad:LayoutPanel>
                    <ad:LayoutAnchorablePane DockWidth="230">
                        <ad:LayoutAnchorable x:Name="historyAnchorable" ContentId="Effect2DEditor.DockForm.HistoryDock" Title="ヒストリーウィンドウ" CanClose="False">
                            <dock:HistoryDock x:Name="historyDock" />
                        </ad:LayoutAnchorable>
                        <ad:LayoutAnchorable x:Name="propertyAnchorable" ContentId="Effect2DEditor.DockForm.PropertyDock" Title="プロパティウィンドウ" CanClose="False">
                            <dock:PropertyDock x:Name="propertyDock" />
                        </ad:LayoutAnchorable>
                    </ad:LayoutAnchorablePane>
                </ad:LayoutPanel>
            </ad:LayoutRoot>
        </ad:DockingManager>
    </DockPanel>
</Window>
