<Window x:Class="Effect2DEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:dock="clr-namespace:Effect2DEditor.DockForm"
        Title="Effect2DEditor" Width="1021" Height="690" Icon="e2dmid.ico"
        AllowDrop="True" DragEnter="MainForm_DragEnter" DragOver="MainForm_DragEnter" Drop="MainForm_DragDrop"
        Closing="MainForm_FormClosing" Closed="Window_Closed" KeyDown="Window_KeyDown">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem x:Name="ファイルToolStripMenuItem" Header="ファイル">
                <MenuItem x:Name="新規作成ToolStripMenuItem" Header="新規作成" InputGestureText="Ctrl+N" Click="新規作成ToolStripMenuItem_Click" />
                <MenuItem x:Name="開くToolStripMenuItem" Header="開く" InputGestureText="Ctrl+O" Click="開くToolStripMenuItem_Click" />
                <MenuItem x:Name="保存するToolStripMenuItem" Header="保存する" InputGestureText="Ctrl+Shift+S" Click="保存するToolStripMenuItem_Click" />
                <MenuItem x:Name="上書き保存するToolStripMenuItem" Header="上書き保存する" InputGestureText="Ctrl+S" Click="上書き保存するToolStripMenuItem_Click" />
                <MenuItem x:Name="最近使用したファイルToolStripMenuItem" Header="最近使用したファイル" />
                <MenuItem x:Name="終了するToolStripMenuItem" Header="終了する" InputGestureText="Alt+F4" Click="終了するToolStripMenuItem_Click" />
            </MenuItem>
            <MenuItem x:Name="編集ToolStripMenuItem" Header="編集">
                <MenuItem x:Name="元に戻すToolStripMenuItem" Header="元に戻す" InputGestureText="Ctrl+Z" Click="元に戻すToolStripMenuItem_Click" />
                <MenuItem x:Name="やり直すToolStripMenuItem" Header="やり直す" InputGestureText="Ctrl+Y" Click="やり直すToolStripMenuItem_Click" />
                <MenuItem x:Name="アニメーションToolStripMenuItem" Header="アニメーション" Click="アニメーションToolStripMenuItem_Click" />
                <MenuItem x:Name="カンバスサイズToolStripMenuItem" Header="カンバスサイズ" Click="カンバスサイズToolStripMenuItem_Click" />
                <MenuItem x:Name="カンバス背景変更ToolStripMenuItem" Header="カンバス背景変更" Click="カンバス背景変更ToolStripMenuItem_Click" />
            </MenuItem>
            <MenuItem x:Name="表示ToolStripMenuItem" Header="表示">
                <MenuItem x:Name="キャンバスウィンドウToolStripMenuItem" Header="キャンバスウィンドウ" Click="キャンバスウィンドウToolStripMenuItem_Click" />
                <MenuItem x:Name="プロパティウィンドウToolStripMenuItem" Header="プロパティウィンドウ" Click="プロパティウィンドウToolStripMenuItem_Click" />
                <MenuItem x:Name="ヒストリーウィンドウToolStripMenuItem" Header="ヒストリーウィンドウ" Click="ヒストリーウィンドウToolStripMenuItem_Click" />
                <MenuItem x:Name="タイムラインウィンドウToolStripMenuItem" Header="タイムラインウィンドウ" Click="タイムラインウィンドウToolStripMenuItem_Click" />
            </MenuItem>
            <MenuItem x:Name="言語ToolStripMenuItem" Header="言語" />
        </Menu>
        <ad:DockingManager x:Name="dockingManager">
            <ad:LayoutRoot>
                <ad:LayoutPanel Orientation="Horizontal">
                    <ad:LayoutPanel Orientation="Vertical">
                        <ad:LayoutDocumentPaneGroup>
                            <ad:LayoutDocumentPane>
                                <ad:LayoutAnchorable x:Name="canvasAnchorable" ContentId="Effect2DEditor.DockForm.CanvasDock" Title="キャンバスウィンドウ" CanClose="False">
                                    <dock:CanvasDock x:Name="canvasDock" />
                                </ad:LayoutAnchorable>
                            </ad:LayoutDocumentPane>
                        </ad:LayoutDocumentPaneGroup>
                        <ad:LayoutAnchorablePane DockHeight="220">
                            <ad:LayoutAnchorable x:Name="timeLineAnchorable" ContentId="Effect2DEditor.DockForm.TimeLineDock" Title="タイムラインウィンドウ" CanClose="False">
                                <dock:TimeLineDock x:Name="timeLineDock" />
                            </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>
                    </ad:LayoutPanel>
                    <ad:LayoutAnchorablePane DockWidth="230">
                        <ad:LayoutAnchorable x:Name="historyAnchorable" ContentId="Effect2DEditor.DockForm.HistoryDock" Title="ヒストリーウィンドウ" CanClose="False">
                            <dock:HistoryDock x:Name="historyDock" />
                        </ad:LayoutAnchorable>
                        <ad:LayoutAnchorable x:Name="propertyAnchorable" ContentId="Effect2DEditor.DockForm.PropertyDock" Title="プロパティウィンドウ" CanClose="False">
                            <dock:PropertyDock x:Name="propertyDock" />
                        </ad:LayoutAnchorable>
                    </ad:LayoutAnchorablePane>
                </ad:LayoutPanel>
            </ad:LayoutRoot>
        </ad:DockingManager>
    </DockPanel>
</Window>
