<UserControl x:Class="Effect2DEditor.DockForm.TimeLineDock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Effect2DEditor"
             xmlns:vm="clr-namespace:Effect2DEditor.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
             AllowDrop="True" DragEnter="TimeLineDock_DragEnter" DragOver="TimeLineDock_DragEnter" Drop="TimeLineDock_Drop">
    <UserControl.Resources>
        <local:EnumEqualsConverter x:Key="EnumEquals" />
        <Style x:Key="ToolImage" TargetType="Image">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <!-- 再生のボタンの画像は、止まっているときは再生のしかた、再生しているときは一時停止 -->
        <Style x:Key="PlayImage" TargetType="Image" BasedOn="{StaticResource ToolImage}">
            <Setter Property="Source" Value="/img/playonce.png" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PlayType}" Value="ReverseOnce">
                    <Setter Property="Source" Value="/img/playreverse.png" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PlayType}" Value="Loop">
                    <Setter Property="Source" Value="/img/playloop.png" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PlayType}" Value="ReverseLoop">
                    <Setter Property="Source" Value="/img/playreverseloop.png" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Source" Value="/img/pause.png" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar>
                <Button AutomationProperties.AutomationId="AddButton" ToolTip="{Binding Texts[Add]}" Command="{Binding AddFilesCommand}">
                    <Image Source="/img/add.png" Style="{StaticResource ToolImage}" />
                </Button>
                <Button AutomationProperties.AutomationId="DeleteButton" ToolTip="{Binding Texts[Delete]}" Command="{Binding DeleteEffectCommand}">
                    <Image Source="/img/remove.png" Style="{StaticResource ToolImage}" />
                </Button>
                <Separator />
                <!-- 再生と一時停止を切り替えるボタンと、再生のしかたを選ぶボタン（以前の分割ボタン） -->
                <ToggleButton AutomationProperties.AutomationId="PlayButton" IsChecked="{Binding IsPlaying}" ToolTip="{Binding PlayToolTip}">
                    <Image Style="{StaticResource PlayImage}" />
                </ToggleButton>
                <Button x:Name="playTypeButton" Padding="1,0" Click="PlayTypeButton_Click">
                    <Path Data="M 0 0 L 6 0 L 3 3 Z" Fill="Black" VerticalAlignment="Center" />
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{Binding Texts[PlayOnce]}" Command="{Binding SelectPlayTypeCommand}" CommandParameter="Once"
                                      IsChecked="{Binding PlayType, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Once}">
                                <MenuItem.Icon>
                                    <Image Source="/img/playonce.png" Style="{StaticResource ToolImage}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{Binding Texts[PlayOnceReverse]}" Command="{Binding SelectPlayTypeCommand}" CommandParameter="ReverseOnce"
                                      IsChecked="{Binding PlayType, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=ReverseOnce}">
                                <MenuItem.Icon>
                                    <Image Source="/img/playreverse.png" Style="{StaticResource ToolImage}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{Binding Texts[PlayLoop]}" Command="{Binding SelectPlayTypeCommand}" CommandParameter="Loop"
                                      IsChecked="{Binding PlayType, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Loop}">
                                <MenuItem.Icon>
                                    <Image Source="/img/playloop.png" Style="{StaticResource ToolImage}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{Binding Texts[PlayReverseLoop]}" Command="{Binding SelectPlayTypeCommand}" CommandParameter="ReverseLoop"
                                      IsChecked="{Binding PlayType, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=ReverseLoop}">
                                <MenuItem.Icon>
                                    <Image Source="/img/playreverseloop.png" Style="{StaticResource ToolImage}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button AutomationProperties.AutomationId="StopButton" ToolTip="{Binding Texts[Stop]}" Command="{Binding StopCommand}">
                    <Image Source="/img/stop.png" Style="{StaticResource ToolImage}" />
                </Button>
                <TextBox AutomationProperties.AutomationId="FpsBox" Width="100" Text="{Binding FpsText, UpdateSourceTrigger=PropertyChanged}" />
                <Separator />
                <Button ToolTip="{Binding Texts[SwapPermutation]}" Command="{Binding ReverseEffectsCommand}">
                    <Image Source="/img/swapreverse.png" Style="{StaticResource ToolImage}" />
                </Button>
                <Button ToolTip="{Binding Texts[Copy]}" Command="{Binding CopyEffectCommand}">
                    <Image Source="/img/copy.png" Style="{StaticResource ToolImage}" />
                </Button>
                <Button ToolTip="{Binding Texts[Clear]}" Command="{Binding ClearEffectCommand}">
                    <Image Source="/img/delete.png" Style="{StaticResource ToolImage}" />
                </Button>
            </ToolBar>
        </ToolBarTray>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="20" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:TimeLineItem x:Name="timeLineItem1" />
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />
            <local:TimeLine x:Name="timeLine1" Grid.Column="2" />
        </Grid>
    </DockPanel>
</UserControl>
