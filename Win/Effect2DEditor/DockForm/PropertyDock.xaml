<UserControl x:Class="Effect2DEditor.DockForm.PropertyDock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Effect2DEditor">
    <UserControl.Resources>
        <Style TargetType="local:ChangeValueLabel">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="23" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="IsEnabled" Value="False" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="62" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>
        <local:ChangeValueLabel x:Name="changeValueLabel2" Text="Blend" />
        <ComboBox x:Name="comboBox1" Grid.Column="1" Width="100" Height="20" VerticalAlignment="Center" SelectionChanged="ComboBox1_SelectedIndexChanged" />

        <local:ChangeValueLabel x:Name="label1" Grid.Row="1" Text="X" ValueChange="Label1_ValueChange" />
        <TextBox x:Name="textBox1" Grid.Row="1" Grid.Column="1" TextChanged="TextBox1_TextChanged" />
        <Button x:Name="button1" Grid.Row="1" Grid.Column="2" Click="Button1_Click" />

        <local:ChangeValueLabel x:Name="label2" Grid.Row="2" Text="Y" ValueChange="Label2_ValueChange" />
        <TextBox x:Name="textBox2" Grid.Row="2" Grid.Column="1" TextChanged="TextBox2_TextChanged" />
        <Button x:Name="button2" Grid.Row="2" Grid.Column="2" Click="Button2_Click" />

        <local:ChangeValueLabel x:Name="label3" Grid.Row="3" Text="Alpha" ValueChange="Label3_ValueChange" />
        <TextBox x:Name="textBox3" Grid.Row="3" Grid.Column="1" TextChanged="TextBox3_TextChanged" />
        <Button x:Name="button3" Grid.Row="3" Grid.Column="2" Click="Button3_Click" />

        <local:ChangeValueLabel x:Name="label4" Grid.Row="4" Text="Rotation" ValueChange="Label4_ValueChange" />
        <TextBox x:Name="textBox4" Grid.Row="4" Grid.Column="1" TextChanged="TextBox4_TextChanged" />
        <Button x:Name="button4" Grid.Row="4" Grid.Column="2" Click="Button4_Click" />

        <local:ChangeValueLabel x:Name="label5" Grid.Row="5" Text="ScaleX" ValueChange="Label5_ValueChange" />
        <TextBox x:Name="textBox5" Grid.Row="5" Grid.Column="1" TextChanged="TextBox5_TextChanged" />
        <Button x:Name="button5" Grid.Row="5" Grid.Column="2" Click="Button5_Click" />

        <local:ChangeValueLabel x:Name="label6" Grid.Row="6" Text="ScaleY" ValueChange="Label6_ValueChange" />
        <TextBox x:Name="textBox6" Grid.Row="6" Grid.Column="1" TextChanged="TextBox6_TextChanged" />
        <Button x:Name="button6" Grid.Row="6" Grid.Column="2" Click="Button6_Click" />

        <local:ChangeValueLabel x:Name="changeValueLabel1" Grid.Row="7" Grid.ColumnSpan="2" Text="BezierPosition" />
        <Button x:Name="button7" Grid.Row="7" Grid.Column="2" Click="Button7_Click" />
    </Grid>
</UserControl>
