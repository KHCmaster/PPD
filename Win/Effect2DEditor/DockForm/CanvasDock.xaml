<UserControl x:Class="Effect2DEditor.DockForm.CanvasDock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:bezier="clr-namespace:BezierDrawControl;assembly=BezierDrawControl">
    <ScrollViewer x:Name="scrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <!-- カンバスが表示領域より小さいときは中央に置く -->
        <Grid MinWidth="{Binding ViewportWidth, ElementName=scrollViewer}" MinHeight="{Binding ViewportHeight, ElementName=scrollViewer}">
            <bezier:DXBezierControl x:Name="bezierControl1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    ContextMenuOpening="ContextMenu_Opening">
                <bezier:DXBezierControl.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="選択したアンカーを削除ToolStripMenuItem" Header="選択したアンカーを削除" Click="選択したアンカーを削除ToolStripMenuItem_Click" />
                        <MenuItem x:Name="変形を開始するToolStripMenuItem" Header="変形を開始する" Click="変形を開始するToolStripMenuItem_Click" />
                        <MenuItem x:Name="変形を終了するToolStripMenuItem" Header="変形を終了する" Click="変形を終了するToolStripMenuItem_Click" />
                        <MenuItem x:Name="リセットするToolStripMenuItem" Header="リセットする" Click="リセットするToolStripMenuItem_Click" />
                    </ContextMenu>
                </bezier:DXBezierControl.ContextMenu>
            </bezier:DXBezierControl>
        </Grid>
    </ScrollViewer>
</UserControl>
