<Window x:Class="Effect2DEditor.ColorPickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:colorCanvas="clr-namespace:ColorCanvas;assembly=ColorCanvas"
        Title="Color" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!-- 以前の WinForms の ColorDialog の代わり -->
    <StackPanel Margin="8">
        <colorCanvas:ColorCanvas x:Name="colorCanvas" Background="Transparent" BorderBrush="{x:Null}" UsingAlphaChannel="False" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="OK" Width="75" Height="23" IsDefault="True" Click="OkButton_Click" />
            <Button Content="Cancel" Width="75" Height="23" Margin="6,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
