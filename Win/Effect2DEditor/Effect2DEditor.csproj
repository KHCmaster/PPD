<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Effect2DEditor</RootNamespace>
    <AssemblyName>Effect2DEditor</AssemblyName>
    <ApplicationIcon>e2dmid.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>false</Prefer32Bit>
    <CodeAnalysisRuleSet>..\PPDCommon.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <OutputPath>..\release\x64\PPD\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpDX" />
    <PackageReference Include="SharpDX.Mathematics" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BezierCaliculator\BezierCaliculator.csproj" />
    <ProjectReference Include="..\BezierDrawControl\BezierDrawControl\BezierDrawControl.csproj" />
    <ProjectReference Include="..\Effect2D\Effect2D.csproj" />
    <ProjectReference Include="..\ErrorHandler\ErrorHandle.csproj" />
    <ProjectReference Include="..\PPDConfiguration\PPDConfiguration.csproj" />
    <ProjectReference Include="..\PPDFramework\PPDFramework.csproj" />
    <ProjectReference Include="..\WinFormsUI\WinFormsUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="AskFrameCount.resx">
      <DependentUpon>AskFrameCount.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="BezierRatioDrawer.resx">
      <DependentUpon>BezierRatioDrawer.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="CanvasSizeForm.resx">
      <DependentUpon>CanvasSizeForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="ChangeBackGroundForm.resx">
      <DependentUpon>ChangeBackGroundForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="DockForm\CanvasDock.resx">
      <DependentUpon>CanvasDock.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="DockForm\HistoryDock.resx">
      <DependentUpon>HistoryDock.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="DockForm\PropertyDock.resx">
      <DependentUpon>PropertyDock.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="DockForm\TimeLineDock.resx">
      <DependentUpon>TimeLineDock.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="HistoryPanel.resx">
      <DependentUpon>HistoryPanel.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="RatioChangeForm.resx">
      <DependentUpon>RatioChangeForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="TimeLine.resx">
      <DependentUpon>TimeLine.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="TimeLineItem.resx">
      <DependentUpon>TimeLineItem.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="TransParentForm.resx">
      <DependentUpon>TransParentForm.cs</DependentUpon>
    </EmbeddedResource>
    <None Update="Lang\lang_Effect2DEditor_en.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_Effect2DEditor_es.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_Effect2DEditor_jp.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_Effect2DEditor_kr.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_Effect2DEditor_zh1.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_Effect2DEditor_zh2.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
</Project>
