<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Effect2DEditor</RootNamespace>
    <AssemblyName>Effect2DEditor</AssemblyName>
    <ApplicationIcon>e2dmid.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>false</Prefer32Bit>
    <CodeAnalysisRuleSet>..\PPDCommon.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <OutputPath>..\release\x64\PPD\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Dirkster.AvalonDock" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PPDMath\PPDMath.csproj" />
    <ProjectReference Include="..\BezierCaliculator\BezierCaliculator.csproj" />
    <ProjectReference Include="..\BezierDrawControl\BezierDrawControl\BezierDrawControl.csproj" />
    <ProjectReference Include="..\Effect2D\Effect2D.csproj" />
    <ProjectReference Include="..\ErrorHandler\ErrorHandle.csproj" />
    <ProjectReference Include="..\PPDConfiguration\PPDConfiguration.csproj" />
    <ProjectReference Include="..\PPDFramework\PPDFramework.csproj" />
    <ProjectReference Include="..\ColorCanvas\ColorCanvas.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Lang\lang_Effect2DEditor_en.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_Effect2DEditor_es.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_Effect2DEditor_jp.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_Effect2DEditor_kr.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_Effect2DEditor_zh1.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_Effect2DEditor_zh2.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="e2dmid.ico" />
    <Resource Include="img\add.png" />
    <Resource Include="img\check.png" />
    <Resource Include="img\copy.png" />
    <Resource Include="img\delete.png" />
    <Resource Include="img\pause.png" />
    <Resource Include="img\playloop.png" />
    <Resource Include="img\playonce.png" />
    <Resource Include="img\playreverse.png" />
    <Resource Include="img\playreverseloop.png" />
    <Resource Include="img\remove.png" />
    <Resource Include="img\stop.png" />
    <Resource Include="img\swapreverse.png" />
  </ItemGroup>
</Project>
