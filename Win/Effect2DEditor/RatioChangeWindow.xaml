<Window x:Class="Effect2DEditor.RatioChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Effect2DEditor"
        Title="RatioChangeForm" Width="250" Height="205" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" SourceInitialized="Window_SourceInitialized">
    <Border BorderBrush="Gray" BorderThickness="1" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
        <Canvas>
            <Border Canvas.Left="25" Canvas.Top="11" BorderBrush="Gray" BorderThickness="1">
                <local:BezierRatioDrawer x:Name="bezierRatioDrawer1" Width="128" Height="128" />
            </Border>
            <Button x:Name="button3" Canvas.Left="159" Canvas.Top="11" Width="75" Height="23" Content="線形変化" Click="Button3_Click" />
            <Button x:Name="button4" Canvas.Left="159" Canvas.Top="40" Width="75" Height="23" Content="コピー" Click="Button4_Click" />
            <Button x:Name="button5" Canvas.Left="159" Canvas.Top="69" Width="75" Height="23" Content="ペースト" Click="Button5_Click" />
            <Button x:Name="button1" Canvas.Left="11" Canvas.Top="171" Width="75" Height="23" Content="OK" IsDefault="True" Click="Button1_Click" />
            <Button x:Name="button2" Canvas.Left="92" Canvas.Top="171" Width="75" Height="23" Content="Cancel" IsCancel="True" />
        </Canvas>
    </Border>
</Window>
