<Window x:Class="Effect2DEditor.AskFrameCountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="アニメーション設定" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="12">
        <TextBlock x:Name="label1" Text="１枚の画像を表示するフレーム数を指定してください" />
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBox x:Name="textBox1" Width="100" Height="20" VerticalContentAlignment="Center" />
            <TextBlock x:Name="label2" Text="フレーム" Margin="6,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <CheckBox x:Name="checkBox1" Content="リバースつき" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button x:Name="button1" Content="OK" Width="75" Height="23" IsDefault="True" Click="Button1_Click" />
            <Button x:Name="button2" Content="Cancel" Width="75" Height="23" Margin="6,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
