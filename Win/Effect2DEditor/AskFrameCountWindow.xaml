<Window x:Class="Effect2DEditor.AskFrameCountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Effect2DEditor.ViewModels.Dialogs"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:AskFrameCountViewModel}"
        Title="{Binding Texts[AFCText]}" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="12">
        <TextBlock Text="{Binding Texts[AFCLabel1]}" />
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBox AutomationProperties.AutomationId="FrameCountBox" Text="{Binding FrameCountText, UpdateSourceTrigger=PropertyChanged}" Width="100" Height="20" VerticalContentAlignment="Center" />
            <TextBlock Text="{Binding Texts[AFCLabel2]}" Margin="6,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <CheckBox AutomationProperties.AutomationId="WithReverseCheck" Content="{Binding Texts[AFCCheckBox1]}" IsChecked="{Binding WithReverse}" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button AutomationProperties.AutomationId="FrameCountOkButton" Content="OK" Width="75" Height="23" IsDefault="True" Command="{Binding OkCommand}" />
            <Button Content="Cancel" Width="75" Height="23" Margin="6,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
