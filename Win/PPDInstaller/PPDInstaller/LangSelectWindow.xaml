<Window x:Class="PPDInstaller.LangSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Language" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" SourceInitialized="Window_SourceInitialized">
    <StackPanel Margin="12">
        <ComboBox x:Name="comboBox1" Width="121" />
        <Button x:Name="button1" Content="OK" Width="75" Height="23" Margin="0,6,0,0" IsDefault="True" Click="Button1_Click" />
    </StackPanel>
</Window>
