<Window x:Class="PPDInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PPDInstaller.Controls"
        xmlns:vm="clr-namespace:PPDInstaller.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="PPDInstaller" SizeToContent="WidthAndHeight" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Icon="ppdinst.ico" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Closing="Window_Closing">
    <Window.Resources>
        <!-- ページの ViewModel ごとの表示 -->
        <DataTemplate DataType="{x:Type vm:StartPageViewModel}">
            <controls:StartPanel />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstallFolderPageViewModel}">
            <controls:InstallPanel />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstallComponentPageViewModel}">
            <controls:InstallComponentPanel />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LinkCreatePageViewModel}">
            <controls:LinkCreatePanel />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfirmPageViewModel}">
            <controls:ConfirmPanel />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FinishPageViewModel}">
            <controls:FinishPanel />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstallAbortedPageViewModel}">
            <controls:InstallAbortedPanel />
        </DataTemplate>
    </Window.Resources>
    <Grid Width="600" Height="300">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="399" />
        </Grid.ColumnDefinitions>
        <Image Source="img/inst.png" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="270" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
            <Canvas Grid.Row="1">
                <Button Canvas.Left="61" Canvas.Top="3" Width="85" Height="23" AutomationProperties.AutomationId="PreviousButton" Content="{Binding Texts[Button3]}" Command="{Binding PreviousCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage.IsPreviousVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Canvas.Left="152" Canvas.Top="3" Width="87" Height="23" AutomationProperties.AutomationId="NextButton" Content="{Binding NextText}" Command="{Binding NextOrCloseCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage.IsNextVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Canvas.Left="276" Canvas.Top="3" MinWidth="90" Height="23" Padding="6,1" AutomationProperties.AutomationId="CancelButton" Content="{Binding Texts[Button1]}" Command="{Binding CancelCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage.IsCancelVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Canvas>
        </Grid>
    </Grid>
</Window>
