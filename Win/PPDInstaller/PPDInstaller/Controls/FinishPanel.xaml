<UserControl x:Class="PPDInstaller.Controls.FinishPanel" AutomationProperties.AutomationId="FinishPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PPDInstaller.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:FinishPageViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Canvas>
        <TextBlock Canvas.Left="16" Canvas.Top="32" FontSize="16" Text="{Binding Texts[Label8]}" />
        <TextBlock Canvas.Left="16" Canvas.Top="62" Text="{Binding Texts[Label9]}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
        <TextBox Canvas.Left="15" Canvas.Top="90" Width="371" Height="148" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Text="{Binding ErrorText, Mode=OneWay}"
                 Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
    </Canvas>
</UserControl>
