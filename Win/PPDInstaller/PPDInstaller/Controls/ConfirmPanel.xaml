<local:PanelBase x:Class="PPDInstaller.Controls.ConfirmPanel"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:PPDInstaller.Controls">
    <Canvas>
        <TextBlock x:Name="label7" Canvas.Left="15" Canvas.Top="15" FontSize="15" Text="以下をダウンロードしインストールします" />
        <TreeView x:Name="treeView1" Canvas.Left="26" Canvas.Top="46" Width="272" Height="179" BorderThickness="0">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,3,0" />
                        <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Canvas>
</local:PanelBase>
