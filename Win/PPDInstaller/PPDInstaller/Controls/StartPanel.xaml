<local:PanelBase x:Class="PPDInstaller.Controls.StartPanel"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:PPDInstaller.Controls">
    <Canvas>
        <TextBlock x:Name="label1" Canvas.Left="3" Canvas.Top="9" FontSize="21" Text="PPDのインストールを開始します" />
        <Button x:Name="button1" Canvas.Left="91" Canvas.Top="87" Width="215" Height="50" FontSize="19" FontWeight="Bold"
                Content="かんたんインストール" Click="Button1_Click" />
        <Button x:Name="button2" Canvas.Left="91" Canvas.Top="158" Width="215" Height="23"
                Content="カスタムインストール" Click="Button2_Click" />
    </Canvas>
</local:PanelBase>
