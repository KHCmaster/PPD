<Window x:Class="PPDUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PPDUpdater" Width="769" SizeToContent="Height" ResizeMode="CanMinimize" Icon="ppdupdatericon.ico"
        WindowState="Minimized" ShowInTaskbar="False" ShowActivated="False"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem x:Name="fileMenuItem" Header="ファイル">
                <MenuItem x:Name="exitMenuItem" Header="終了" Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem x:Name="languageMenuItem" Header="言語" />
        </Menu>
        <StackPanel Margin="12,4,12,12">
            <!-- 更新の確認中だけ表示する -->
            <StackPanel x:Name="checkingPanel" Orientation="Horizontal" Height="18" Visibility="Hidden">
                <ProgressBar IsIndeterminate="True" Width="60" Height="10" VerticalAlignment="Center" />
                <TextBlock x:Name="checkingText" Text="更新を確認中…" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <DataGrid x:Name="updateGrid" Height="205" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      CanUserDeleteRows="False" CanUserResizeColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="versionColumn" Header="バージョン" Binding="{Binding Info}" Width="*" />
                    <DataGridTextColumn x:Name="stateColumn" Header="状態" Binding="{Binding State}" Width="*" />
                    <DataGridTemplateColumn x:Name="downloadColumn" Header="ダウンロード" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}" Maximum="100" Margin="2" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="installColumn" Header="インストール" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ProgressBar Value="{Binding InstallProgress, Mode=OneWay}" Maximum="100" Margin="2" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <DockPanel Margin="0,7,0,0">
                <Button x:Name="closeButton" DockPanel.Dock="Right" Content="閉じる" Width="75" Click="CloseButton_Click" />
                <TextBlock x:Name="currentVersionLabel" Text="現在のバージョン" VerticalAlignment="Center" />
                <TextBlock x:Name="currentVersionText" Text="0.0.0.0" Margin="40,0,0,0" VerticalAlignment="Center" />
            </DockPanel>
            <DockPanel Margin="0,10,0,0">
                <Button x:Name="toggleLogButton" DockPanel.Dock="Right" VerticalAlignment="Top" Content="表示/非表示" MinWidth="106" Margin="6,0,0,0" Click="ToggleLogButton_Click" />
                <GroupBox x:Name="logGroupBox" Header="ログ">
                    <TextBox x:Name="logTextBox" Height="95" Margin="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Visibility="Collapsed" />
                </GroupBox>
            </DockPanel>
        </StackPanel>
    </DockPanel>
</Window>
