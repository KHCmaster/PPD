<UserControl x:Class="FlowScriptControl.Controls.FlowTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:classes="clr-namespace:FlowScriptControl.Classes">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <BitmapImage x:Key="FolderImage" UriSource="pack://application:,,,/FlowScriptControl;component/Img/folder.png" />
        <BitmapImage x:Key="FlowSourceImage" UriSource="pack://application:,,,/FlowScriptControl;component/Img/flowsource.png" />
    </UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="2">
            <ComboBox x:Name="filterComboBox" DockPanel.Dock="Right" Width="121" Margin="4,0,0,0"
                      DisplayMemberPath="Name" SelectionChanged="FilterComboBox_SelectionChanged" />
            <TextBox x:Name="filterTextBox" KeyDown="FilterTextBox_KeyDown" VerticalContentAlignment="Center" />
        </DockPanel>
        <TreeView x:Name="treeView" KeyDown="TreeView_KeyDown"
                  PreviewMouseLeftButtonDown="TreeView_PreviewMouseLeftButtonDown" PreviewMouseMove="TreeView_PreviewMouseMove">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibility}}" />
                    <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
                    <Setter Property="ToolTipService.InitialShowDelay" Value="1000" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type classes:FlowNodeEntry}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="icon" Width="16" Height="16" Margin="0,0,3,0" Source="{StaticResource FlowSourceImage}" />
                        <TextBlock Text="{Binding Text}" />
                    </StackPanel>
                    <HierarchicalDataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                            <Setter TargetName="icon" Property="Source" Value="{StaticResource FolderImage}" />
                        </DataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</UserControl>
