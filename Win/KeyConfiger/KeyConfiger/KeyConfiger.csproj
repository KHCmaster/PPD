<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>KeyConfiger</RootNamespace>
    <AssemblyName>KeyConfiger</AssemblyName>
    <ApplicationIcon>kc.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>false</Prefer32Bit>
    <CodeAnalysisRuleSet>..\..\PPDCommon.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <OutputPath>..\..\release\x64\PPD\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.DirectInput" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ErrorHandler\ErrorHandle.csproj" />
    <ProjectReference Include="..\..\PPDConfiguration\PPDConfiguration.csproj" />
    <ProjectReference Include="..\..\PPDFrameworkCore\PPDFrameworkCore.csproj" />
    <ProjectReference Include="..\..\PPDFramework\PPDFramework.csproj" />
    <ProjectReference Include="..\..\PPDInput\PPDInput.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Lang\lang_KeyConfiger_en.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_KeyConfiger_es.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_KeyConfiger_jp.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_KeyConfiger_kr.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_KeyConfiger_zh1.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Lang\lang_KeyConfiger_zh2.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="kc.ico" />
  </ItemGroup>
</Project>
