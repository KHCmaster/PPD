<Window x:Class="KeyConfiger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyConfiger" Width="389" Height="430" ResizeMode="CanMinimize" Icon="kc.ico"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem x:Name="languageMenuItem" Header="言語" />
            <MenuItem x:Name="settingMenuItem" Header="設定">
                <MenuItem x:Name="createSettingMenuItem" Header="新しい設定を作成" Click="CreateSettingMenuItem_Click" />
                <MenuItem x:Name="deleteSettingMenuItem" Header="現在の設定を削除" Click="DeleteSettingMenuItem_Click" />
                <Separator />
            </MenuItem>
            <MenuItem x:Name="controllerMenuItem" Header="コントローラー">
                <MenuItem x:Name="reloadControllerMenuItem" Header="コントローラーを再取得" Click="ReloadControllerMenuItem_Click" />
                <Separator />
            </MenuItem>
        </Menu>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="keyGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      CanUserSortColumns="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="All" RowHeaderWidth="90"
                      PreviewKeyDown="KeyGrid_PreviewKeyDown" MouseLeftButtonUp="KeyGrid_MouseLeftButtonUp">
                <DataGrid.RowHeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DataContext.Header, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                    </DataTemplate>
                </DataGrid.RowHeaderTemplate>
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="keyboardColumn" Header="キーボード" Binding="{Binding Key}" Width="*" />
                    <DataGridTextColumn x:Name="gamepadColumn" Header="ゲームパッド" Binding="{Binding Button}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="1" Margin="0,6,0,0">
                <Button x:Name="changeButton" Content="選択行を変更する" Width="193" Click="ChangeButton_Click" />
                <TextBlock x:Name="waitingText" Text="入力待ち中…" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Hidden" />
            </DockPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                <Button Content="OK" Width="75" Margin="0,0,24,0" Click="OkButton_Click" />
                <Button Content="Cancel" Width="75" Click="CancelButton_Click" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
