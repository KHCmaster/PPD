<Window x:Class="KeyConfiger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KeyConfiger.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="KeyConfiger" Width="389" Height="430" ResizeMode="CanMinimize" Icon="kc.ico"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <vm:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <!-- 選ぶメニューの項目（名前の「_」がアクセスキーとして扱われないように、TextBlock で表示する） -->
        <Style x:Key="OptionMenuItem" TargetType="MenuItem">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ToolTip" Value="{Binding Name}" />
            <Setter Property="IsChecked" Value="{Binding IsChecked}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        </Style>
        <vm:OptionStyleSelector x:Key="LanguageItemSelector">
            <vm:OptionStyleSelector.OptionStyle>
                <Style TargetType="MenuItem" BasedOn="{StaticResource OptionMenuItem}">
                    <Setter Property="Command" Value="{Binding Data.SelectLanguageCommand, Source={StaticResource Proxy}}" />
                </Style>
            </vm:OptionStyleSelector.OptionStyle>
        </vm:OptionStyleSelector>
        <vm:OptionStyleSelector x:Key="ConfigItemSelector">
            <vm:OptionStyleSelector.OptionStyle>
                <Style TargetType="MenuItem" BasedOn="{StaticResource OptionMenuItem}">
                    <Setter Property="Command" Value="{Binding Data.SelectConfigCommand, Source={StaticResource Proxy}}" />
                </Style>
            </vm:OptionStyleSelector.OptionStyle>
        </vm:OptionStyleSelector>
        <vm:OptionStyleSelector x:Key="ControllerItemSelector">
            <vm:OptionStyleSelector.OptionStyle>
                <Style TargetType="MenuItem" BasedOn="{StaticResource OptionMenuItem}">
                    <Setter Property="Command" Value="{Binding Data.SelectControllerCommand, Source={StaticResource Proxy}}" />
                </Style>
            </vm:OptionStyleSelector.OptionStyle>
        </vm:OptionStyleSelector>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{Binding Texts[Language]}" ItemsSource="{Binding Languages}" ItemContainerStyleSelector="{StaticResource LanguageItemSelector}" />
            <MenuItem Header="{Binding Texts[Setting]}" ItemContainerStyleSelector="{StaticResource ConfigItemSelector}">
                <MenuItem.ItemsSource>
                    <CompositeCollection>
                        <MenuItem Header="{Binding Data.Texts[CreateNewSetting], Source={StaticResource Proxy}}" Command="{Binding Data.CreateConfigCommand, Source={StaticResource Proxy}}" />
                        <MenuItem Header="{Binding Data.Texts[DeleteCurrentSetting], Source={StaticResource Proxy}}" Command="{Binding Data.DeleteConfigCommand, Source={StaticResource Proxy}}" />
                        <Separator />
                        <CollectionContainer Collection="{Binding Data.Configs, Source={StaticResource Proxy}}" />
                    </CompositeCollection>
                </MenuItem.ItemsSource>
            </MenuItem>
            <MenuItem Header="{Binding Texts[Gamepad]}" ItemContainerStyleSelector="{StaticResource ControllerItemSelector}">
                <MenuItem.ItemsSource>
                    <CompositeCollection>
                        <MenuItem Header="{Binding Data.Texts[ResetControllerList], Source={StaticResource Proxy}}" Command="{Binding Data.ReloadControllersCommand, Source={StaticResource Proxy}}" />
                        <Separator />
                        <CollectionContainer Collection="{Binding Data.Controllers, Source={StaticResource Proxy}}" />
                    </CompositeCollection>
                </MenuItem.ItemsSource>
            </MenuItem>
        </Menu>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="keyGrid" ItemsSource="{Binding Rows}" SelectedIndex="{Binding SelectedIndex}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      CanUserSortColumns="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="All" RowHeaderWidth="90"
                      PreviewKeyDown="KeyGrid_PreviewKeyDown" MouseLeftButtonUp="KeyGrid_MouseLeftButtonUp">
                <DataGrid.RowHeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DataContext.Header, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                    </DataTemplate>
                </DataGrid.RowHeaderTemplate>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding Data.Texts[Keyboard], Source={StaticResource Proxy}}" Binding="{Binding Key}" Width="*" />
                    <DataGridTextColumn Header="{Binding Data.Texts[Gamepad], Source={StaticResource Proxy}}" Binding="{Binding Button}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="1" Margin="0,6,0,0">
                <Button Content="{Binding Texts[Button1]}" Width="193" Command="{Binding WaitForInputCommand}" />
                <TextBlock Text="{Binding Texts[Label1]}" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWaitingInput}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                <Button Content="OK" Width="75" Margin="0,0,24,0" Command="{Binding OkCommand}" />
                <Button Content="Cancel" Width="75" Command="{Binding CancelCommand}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
