<Window x:Class="KeyConfiger.NewConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新しい設定を作成" Width="300" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="12,8,12,12">
        <TextBlock x:Name="nameLabel" Text="新しい設定の名前を決めてください" TextWrapping="Wrap" />
        <TextBox x:Name="nameTextBox" Margin="0,4,0,0" TextChanged="NameTextBox_TextChanged" />
        <TextBlock x:Name="noteLabel" Text="(※現在の設定をコピーした新規の設定を作成します)" TextWrapping="Wrap" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="okButton" Content="OK" Width="75" IsDefault="True" IsEnabled="False" Margin="0,0,36,0" Click="OkButton_Click" />
            <Button Content="Cancel" Width="75" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
