<Window x:Class="FolderDiffChecker.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UserForm" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Loaded="Window_Loaded">
    <StackPanel Margin="16,8,16,12">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="ユーザー名:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="userNameTextBox" Width="117" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button Content="OK" Width="75" IsDefault="True" Click="OkButton_Click" Margin="0,0,6,0" />
            <Button Content="Cancel" Width="75" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
