<Project Sdk="Microsoft.NET.Sdk">
  <!-- ViewModel や Model の単体テストです。画面は表示しないので、デスクトップがなくても実行できる -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>UnitTests</RootNamespace>
    <AssemblyName>UnitTests</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>disable</Nullable>
    <!-- AssemblyInfo.cs がないので、アセンブリの情報を生成する -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BMSTOPPD\BMSTOPPD\BMSTOPPD.csproj" />
    <ProjectReference Include="..\KeyConfiger\KeyConfiger\KeyConfiger.csproj" />
    <ProjectReference Include="..\PPDFramework\PPDFramework.csproj" />
    <ProjectReference Include="..\PPDConfig\PPDConfig.csproj" />
    <ProjectReference Include="..\PPDUpdater\PPDUpdater.csproj" />
    <ProjectReference Include="..\FolderDiffChecker\FolderDiffChecker.csproj" />
    <ProjectReference Include="..\PPDInstaller\PPDInstaller\PPDInstaller.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- アプリが今のフォルダから読む言語ファイル。テストでは一時フォルダにコピーして使う（AppFiles） -->
    <None Include="..\KeyConfiger\KeyConfiger\Lang\*.ini" Link="Apps\KeyConfiger\Lang\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PPDConfig\Lang\*.ini" Link="Apps\PPDConfig\Lang\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PPDUpdater\Lang\*.ini" Link="Apps\PPDUpdater\Lang\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PPDInstaller\PPDInstaller\Lang\*.ini" Link="Apps\PPDInstaller\Lang\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="coverage.runsettings" CopyToOutputDirectory="Never" />
  </ItemGroup>
</Project>
