<Window x:Class="PPDConfig.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PPDConfig.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="PPDConfig" Width="560" Height="640" ResizeMode="CanMinimize" Icon="ppdconfigicon.ico">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="2" />
        </Style>
    </Window.Resources>
    <!-- AutomationId は UI の自動テスト（UITests）で使う。BlueSky のタブはテストで開かないので付けない -->
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem AutomationProperties.AutomationId="LanguageMenu" Header="{Binding Texts[Language]}" ItemsSource="{Binding Languages}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="IsChecked" Value="{Binding IsChecked}" />
                        <Setter Property="Command" Value="{Binding DataContext.SelectLanguageCommand, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
                        <Setter Property="CommandParameter" Value="{Binding}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
                <MenuItem.ItemTemplate>
                    <DataTemplate>
                        <!-- 名前の「_」がアクセスキーとして扱われないように、TextBlock で表示する -->
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </MenuItem.ItemTemplate>
            </MenuItem>
        </Menu>
        <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="12,8,12,12">
            <Button AutomationProperties.AutomationId="OkButton" Content="{Binding Texts[Button5]}" Height="30" Margin="0,0,6,0" Command="{Binding OkCommand}" />
            <Button AutomationProperties.AutomationId="CancelButton" Content="{Binding Texts[Button6]}" Height="30" Margin="3,0" Command="{Binding CancelCommand}" />
            <Button AutomationProperties.AutomationId="DefaultButton" Content="{Binding Texts[Button7]}" Height="30" Margin="6,0,0,0" Command="{Binding SetDefaultCommand}" />
        </UniformGrid>
        <TabControl Margin="8,8,8,0">
            <TabItem AutomationProperties.AutomationId="GeneralTab" Header="{Binding Texts[TabPage1]}">
                <StackPanel Margin="40,12,40,12">
                    <DockPanel Margin="0,4">
                        <TextBox AutomationProperties.AutomationId="WindowSizeBox" DockPanel.Dock="Right" Width="156" Text="{Binding WindowSize, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding Texts[Label13]}" VerticalAlignment="Center" />
                    </DockPanel>
                    <CheckBox AutomationProperties.AutomationId="FullScreenCheck" Content="{Binding Texts[CheckBox3]}" IsChecked="{Binding FullScreen}" />
                    <CheckBox Content="{Binding Texts[CheckBox6]}" IsChecked="{Binding DrawConnectUnderAllMark}" />
                    <DockPanel Margin="0,4">
                        <TextBox DockPanel.Dock="Right" Width="97" AutomationProperties.AutomationId="MonitorLatencyBox" Text="{Binding MonitorLatency, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding Texts[Label2]}" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBox DockPanel.Dock="Right" Width="97" AutomationProperties.AutomationId="MovieLatencyBox" Text="{Binding MovieLatency, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding Texts[Label14]}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding Texts[Label19]}" TextWrapping="Wrap" Margin="0,10,0,2" />
                    <TextBox TextWrapping="Wrap" AutomationProperties.AutomationId="MovieExtensionsBox" Text="{Binding MovieExtensions, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding Texts[MusicExtensions]}" TextWrapping="Wrap" Margin="0,10,0,2" />
                    <TextBox TextWrapping="Wrap" AutomationProperties.AutomationId="MusicExtensionsBox" Text="{Binding MusicExtensions, UpdateSourceTrigger=PropertyChanged}" />
                    <GroupBox Header="{Binding Texts[GroupBox1]}" Margin="0,14,0,0" Padding="8,4">
                        <StackPanel>
                            <DockPanel Margin="0,3">
                                <TextBox DockPanel.Dock="Right" Width="144" AutomationProperties.AutomationId="FontNameBox" Text="{Binding FontName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding Texts[Label7]}" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBox DockPanel.Dock="Right" Width="144" AutomationProperties.AutomationId="FontSizeBox" Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding Texts[Label9]}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="{Binding Texts[TabPage2]}">
                <Grid Margin="30,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Texts[Label16]}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Margin="0,4" Text="{Binding BlueSkyId, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text=".bsky.social" VerticalAlignment="Center" Margin="4,0,0,0" />
                    <TextBlock Grid.Row="1" Text="{Binding Texts[Label18]}" VerticalAlignment="Center" />
                    <!-- PasswordBox は値をバインドできないので、コードビハインドで ViewModel とやり取りする -->
                    <PasswordBox x:Name="blueSkyPasswordBox" Grid.Row="1" Grid.Column="1" Margin="0,4" VerticalContentAlignment="Center" Padding="2"
                                 PasswordChanged="BlueSkyPasswordBox_PasswordChanged" />
                </Grid>
            </TabItem>
            <TabItem AutomationProperties.AutomationId="DetailTab" Header="{Binding Texts[TabPage3]}">
                <StackPanel Margin="10,8">
                    <CheckBox AutomationProperties.AutomationId="TextBoxDisabledCheck" Content="{Binding Texts[CheckBox1]}" IsChecked="{Binding TextBoxDisabled}" />
                    <CheckBox Content="{Binding Texts[CheckBox2]}" IsChecked="{Binding DrawSameColorDisabled}" />
                    <CheckBox Content="{Binding Texts[CheckBox5]}" IsChecked="{Binding AllowedToUseMuchMemory}" />
                    <CheckBox Content="{Binding Texts[CheckBox7]}" IsChecked="{Binding EveryFramePollingDisabled}" />
                    <TextBlock Text="{Binding Texts[AccurateInputSleepTimeDesc]}" TextWrapping="Wrap" Margin="0,6,0,2" />
                    <ComboBox Width="200" HorizontalAlignment="Right" ItemsSource="{Binding AccurateInputSleepTimes}" SelectedItem="{Binding AccurateInputSleepTime}" />
                    <CheckBox Content="{Binding Texts[CheckBox8]}" IsChecked="{Binding MenuMoviePreviewDisabled}" />
                    <CheckBox Content="{Binding Texts[DisableAutoAdjustLatency]}" IsChecked="{Binding AutoAdjustLatencyDisabled}" />
                    <CheckBox Content="{Binding Texts[DisableFontScale]}" IsChecked="{Binding FontScaleDisabled}" />
                    <CheckBox Content="{Binding Texts[DisableHighResolutionImage]}" IsChecked="{Binding HighResolutionImageDisabled}" />
                    <CheckBox Content="{Binding Texts[DisableFixedFPS]}" IsChecked="{Binding FixedFPSDisabled}" />
                </StackPanel>
            </TabItem>
            <TabItem AutomationProperties.AutomationId="ExpansionTab" Header="{Binding Texts[ExpansionSetting]}">
                <StackPanel Margin="10,8">
                    <CheckBox AutomationProperties.AutomationId="RunExpansionCheck" Content="{Binding Texts[Use PPDExpansion]}" IsChecked="{Binding RunExpansion}" />
                    <DockPanel Margin="32,6,0,0">
                        <TextBox DockPanel.Dock="Right" Width="164" AutomationProperties.AutomationId="ExpansionPortBox" Text="{Binding ExpansionPort, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding Texts[Using Port]}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
