<Window x:Class="BMSTOPPD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BMSTOPPD" SizeToContent="WidthAndHeight" ResizeMode="CanMinimize"
        Icon="bmstoppd.ico" Closing="Window_Closing">
    <Grid Margin="12,8,12,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="191" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="75" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="filename" />
        <TextBox x:Name="fileNameTextBox" Grid.Row="1" Grid.Column="0" Margin="0,2,0,0" VerticalContentAlignment="Center" />
        <Button Grid.Row="1" Grid.Column="2" Content="open" Margin="0,2,0,0" Click="OpenButton_Click" />
        <TextBlock Grid.Row="2" Text="timeoffset" Margin="0,10,0,0" />
        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,2,0,0">
            <TextBox x:Name="timeOffsetTextBox" Width="100" VerticalContentAlignment="Center" />
        </StackPanel>
        <Button Grid.Row="3" Grid.Column="2" Content="convert" Margin="0,2,0,0" Click="ConvertButton_Click" />
        <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="setting" Width="75" Click="SettingButton_Click" />
            <CheckBox x:Name="dtxCheckBox" Content="DTXformat?" Margin="52,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
