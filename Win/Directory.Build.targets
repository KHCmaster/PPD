<Project>
  <!-- FlowScript 拡張（FlowScriptEngine*）を、Debug ビルドのときに各アプリの dlls フォルダーへコピーする。
       コピー先は各プロジェクトの FlowScriptPluginFolder で指定する。コピー先のアプリは Windows 用なので、Linux でのビルド（Linux\Linux.sln）ではコピーしない。 -->
  <Target Name="CopyFlowScriptPlugin" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' And '@(FlowScriptPluginFolder)' != '' And '$(OS)' == 'Windows_NT'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="%(FlowScriptPluginFolder.FullPath)" SkipUnchangedFiles="true" />
  </Target>

  <!-- exe には、起動時の共通設定（コードページの登録、WinForms の既定フォント）を入れる -->
  <PropertyGroup Condition="('$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe') And '$(UseWindowsForms)' == 'true'">
    <DefineConstants>$(DefineConstants);PPD_WINFORMS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared\ProcessInitializer.cs" Link="Properties\ProcessInitializer.cs" />
  </ItemGroup>

  <!-- Windows 用（net10.0-windows）のプロジェクトが Windows 専用であることを示す属性（GenerateAssemblyInfo=false では自動生成されないため）。
       Linux でも使うライブラリ（FlowScriptEngine、PPDMultiServer など。net10.0）には付けない -->
  <ItemGroup Condition="'$(Language)' == 'C#' And '$(TargetPlatformIdentifier)' == 'windows'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared\SupportedPlatform.cs" Link="Properties\SupportedPlatform.cs" />
  </ItemGroup>
</Project>
